[PATCH 2/2] arm64: vmlinux.lds.S: keep .bss.rtic inside the kernel image

PREREQUISITE for any rebuild: without it the kernel does not boot at all.
.bss.rtic (which holds selinux_state) used to be a second ".bss" output
section placed after the zero-address debug sections.  GNU ld 2.27 merged it
into .bss, but modern linkers (GNU ld 2.38 / lld) either fail to link
("relocation R_AARCH64_ADR_PREL_PG_HI21 out of range") or place it after
_end, where the page allocator reuses it and corrupts selinux_state - the
device then hangs on the first screen (verified on hardware).
--- a/arch/arm64/kernel/vmlinux.lds.S
+++ b/arch/arm64/kernel/vmlinux.lds.S
@@ -231,6 +231,21 @@
 
 	BSS_SECTION(0, 0, 0)
 
+	/*
+	 * EEBBK/BBK RTIC data (__rticdata -> .bss.rtic, contains selinux_state).
+	 *
+	 * It must live INSIDE the kernel image (before _end): the kernel only
+	 * reserves _text.._end, so data placed after _end gets handed out by the
+	 * page allocator and any write to it corrupts selinux_state.
+	 *
+	 * It also must be emitted before the zero-address debug sections
+	 * (STABS_DEBUG) and must not be a second ".bss" output section - both
+	 * make the location counter/linker place it outside .text's ADRP range.
+	 */
+	.bss.rtic : {			/* RTIC bss segment	*/
+		RTIC_BSS
+	}
+
 	. = ALIGN(PAGE_SIZE);
 	idmap_pg_dir = .;
 	. += IDMAP_DIR_SIZE;
@@ -253,10 +268,6 @@
 	STABS_DEBUG
 
 	HEAD_SYMBOLS
-
-	.bss : {			/* bss segment		*/
-         RTIC_BSS
-	}
 }
 
 /*
