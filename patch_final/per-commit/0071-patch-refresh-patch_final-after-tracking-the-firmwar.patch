++-CONFIG_INPUT_HALL=y
++-CONFIG_VIB_PWM=y
++-CONFIG_INPUT_MXM1120=y   CONFIG_INPUT_MXM1120_UP=y   CONFIG_INPUT_MXM1120_DOWN=y
++-CONFIG_INPUT_IST8801=y
