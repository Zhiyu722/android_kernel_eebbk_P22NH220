+++	size = q->size;
+++	idx = q->index;
+++	newest = q->up[(idx + size - 1) % size];
+++	prev = q->up[(idx + size - 2) % size];
+++	oldest = q->up[idx % size];
+++	dnewest = q->down[(idx + size - 1) % size];
+++	dprev = q->down[(idx + size - 2) % size];
+++	doldest = q->down[idx % size];
