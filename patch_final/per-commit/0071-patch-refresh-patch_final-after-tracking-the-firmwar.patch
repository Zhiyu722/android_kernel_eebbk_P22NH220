++-++| `"0x27d"`、`"637"` | `set_camera(0)`; `h[428]=1`; 按键 **637**（"angle move"） |
++-++| `"0x27f"`、`"639"` | 按键 **639**（"not holder angle"），不改状态 |
++-++| `"0x280"`、`"640"` | 按键 **640**（"holder angle"） |
++-++| `"0x282"`、`"642"` | 按键 **642** |
