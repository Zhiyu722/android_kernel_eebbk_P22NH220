++-++do2:  /* enable == 2：与 1 相同，唯一区别是 dir_gpio 置 1，且不打印 clk_prepare 日志 */
++-++    … dir_gpio=1; boost=1; msleep(3); enable=0; sleep=1; msleep(3); clk_enable; hrtimer_start …
