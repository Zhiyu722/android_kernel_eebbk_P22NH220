+++    if (size == 0)
+++        return NULL;
+++
+++    /* do not attempt kmalloc if we need more than 16 pages at once */
+++    if (size <= (16 * PAGE_SIZE))
+++        buffer = kmalloc(size, flags | GFP_NOIO | __GFP_NOWARN);
+++    if (!buffer) {
+++        if (flags & __GFP_ZERO)
+++            buffer = vzalloc(size);
+++        else
+++            buffer = vmalloc(size);
+++    }
+++    return buffer;
+++#else
+++    return kvmalloc(size, flags);
+++#endif
+++}
