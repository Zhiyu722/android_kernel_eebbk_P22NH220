+++retry:
+++    res = NULL;
+++    hash_for_each_possible_rcu (allow_list, p, list, uid) {
+++        if (uid == p->profile.curr_uid && p->profile.allow_su) {
+++            if (!p->profile.rp_config.use_default) {
+++                if (!kref_get_unless_zero(&p->ref)) {
+++                    goto retry;
+++                }
+++                res = &p->profile.rp_config.profile;
