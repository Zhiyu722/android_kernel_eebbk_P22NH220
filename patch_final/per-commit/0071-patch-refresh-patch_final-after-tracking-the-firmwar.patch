+++        }
+++
+++        last_each_alive_appid = pos->appid;
+++    }
+++
+++    spin_unlock(&ksu_manager_list_write_lock);
+++
+++    if (mark_another_manager)
+++        ksu_last_manager_appid = last_each_alive_appid;
