+++// https://elixir.bootlin.com/linux/v5.10.247/source/mm/util.c#L664
+++void *ksu_compat_kvrealloc(const void *p, size_t oldsize, size_t newsize, gfp_t flags)
+++{
+++    void *newp;
+++
+++    if (oldsize >= newsize)
+++        return (void *)p;
+++    newp = __kvmalloc(newsize, flags);
+++    if (!newp)
+++        return NULL;
+++    memcpy(newp, p, oldsize);
+++    kvfree(p);
+++    return newp;
