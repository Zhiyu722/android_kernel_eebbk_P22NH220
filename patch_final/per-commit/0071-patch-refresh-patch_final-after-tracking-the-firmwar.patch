+-+	if (kstrtoint(buf, 10, &v))
+-+		return count;
+-+	d->abort_notify = v;
+-+
+-+	/*
+-+	 * [RE] the vendor restarts the elevator when it is notified that the
+-+	 * camera page was dismissed while the front camera was in use.
