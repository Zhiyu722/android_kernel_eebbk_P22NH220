++index 000000000..f35b075c0
++--- /dev/null
+++++ b/patch+++/0029-media-cam_eeprom-Read-the-memory-map-the-way-the-fac.patch
++@@ -0,0 +1,141 @@
+++From 83639f69c874b65b250a01ce044422da63cead3e Mon Sep 17 00:00:00 2001
+++From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++Date: Sun, 13 Sep 2026 10:45:47 +0800
+++Subject: [PATCH 29/40] media: cam_eeprom: Read the memory map the way the
+++ factory device tree names it
+++
+++The front camera never reached the camera provider: only the rear one is
+++enumerated, and the provider logs
+++
+++    W CHIUSECASE: BuildLogicalCameraInfo() Please check if sensor id:1..6 is
+++      probed successfully!
+++
+++while BBK's own hook in the Hal reads the module information correctly
+++
+++    [tyydebug] read number = 74, frontCameraInfo: Module Vendor: TSP ,
+++      Image Sensor: OmniVision ov16a10(16M)(FF)(RAW)(MIPI)
+++
+++so the data this tree publishes in /proc/driver/FrontCamera_info is fine and
+++the failure is inside the kernel.  The kernel log says which part:
+++
+++  CAM_ERR: CAM-EEPROM: cam_eeprom_parse_dt_memory_map: 134 failed: num-blocks
+++    not available rc -22
+++
+++No eeprom subdevice is created for either camera, and the front sensor, which
+++the Hal probes together with its eeprom (cam-sensor@1 has eeprom-src), is then
+++dropped.
+++
+++The reason is a property name mismatch.  The factory device tree names every
+++memory map property with a qcom, prefix:
+++
+++    qcom,num-blocks = <0x02>;
+++    qcom,page0 = ...; qcom,poll0 = ...; qcom,mem0 = ...;
+++    qcom,page1 = ...; qcom,poll1 = ...; qcom,mem1 = ...;
+++
+++and the rest of this camera stack reads its device tree the same way
+++(qcom,cam-power-seq-type, qcom,cam-power-seq-cfg-val, qcom,slave-addr,
+++qcom,i2c-freq-mode).  cam_eeprom_parse_dt_memory_map, however, looked the six
+++names up unprefixed - num-blocks, page%d, pageen%d, saddr%d, poll%d, mem%d - so
+++it failed on the first one and tore the whole map down.
+++
+++Try the prefixed name first and fall back to the bare one, which keeps both this
+++device tree and an upstream one working.
+++
+++Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++---
+++ .../cam_eeprom/cam_eeprom_soc.c               | 44 ++++++++++++++++---
+++ 1 file changed, 38 insertions(+), 6 deletions(-)
+++
+++diff --git a/drivers/media/platform/msm/camera/cam_sensor_module/cam_eeprom/cam_eeprom_soc.c b/drivers/media/platform/msm/camera/cam_sensor_module/cam_eeprom/cam_eeprom_soc.c
+++index bd087b7ec..e8ab01cc2 100644
+++--- a/drivers/media/platform/msm/camera/cam_sensor_module/cam_eeprom/cam_eeprom_soc.c
++++++ b/drivers/media/platform/msm/camera/cam_sensor_module/cam_eeprom/cam_eeprom_soc.c
+++@@ -119,6 +119,38 @@ int cam_eeprom_spi_parse_of(struct cam_sensor_spi_client *spi_dev)
+++  * the @of node, calculate total data length, and allocates required buffer.
+++  * It only fills the map, but does not perform actual reading.
+++  */
++++/*
++++ * EEBBK S6 (P20H130): the factory device tree names every memory map property
++++ * with the qcom, prefix - qcom,num-blocks, qcom,page0, qcom,poll0, qcom,mem0
++++ * and so on - while this driver looks them up unprefixed.  The whole map then
++++ * failed to parse ("num-blocks not available rc -22"), so no eeprom subdevice
++++ * was created for either camera and the front camera never reached the camera
++++ * provider.  Try the prefixed name first and fall back to the bare one, which
++++ * keeps an upstream device tree working too.
++++ */
++++static int cam_eeprom_read_u32_prop(struct device_node *node, const char *name,
++++				    uint32_t *value)
++++{
++++	char property[PROPERTY_MAXSIZE];
++++
++++	snprintf(property, PROPERTY_MAXSIZE, "qcom,%s", name);
++++	if (!of_property_read_u32(node, property, value))
++++		return 0;
++++	return of_property_read_u32(node, name, value);
++++}
++++
++++static int cam_eeprom_read_u32_array_prop(struct device_node *node,
++++					  const char *name, uint32_t *value,
++++					  uint32_t count)
++++{
++++	char property[PROPERTY_MAXSIZE];
++++
++++	snprintf(property, PROPERTY_MAXSIZE, "qcom,%s", name);
++++	if (!of_property_read_u32_array(node, property, value, count))
++++		return 0;
++++	return of_property_read_u32_array(node, name, value, count);
++++}
++++
+++ int cam_eeprom_parse_dt_memory_map(struct device_node *node,
+++ 	struct cam_eeprom_memory_block_t *data)
+++ {
+++@@ -128,7 +160,7 @@ int cam_eeprom_parse_dt_memory_map(struct device_node *node,
+++ 	struct    cam_eeprom_memory_map_t *map;
+++ 
+++ 	snprintf(property, PROPERTY_MAXSIZE, "num-blocks");
+++-	rc = of_property_read_u32(node, property, &data->num_map);
++++	rc = cam_eeprom_read_u32_prop(node, property, &data->num_map);
+++ 	if (rc < 0) {
+++ 		CAM_ERR(CAM_EEPROM, "failed: num-blocks not available rc %d",
+++ 			rc);
+++@@ -144,7 +176,7 @@ int cam_eeprom_parse_dt_memory_map(struct device_node *node,
+++ 
+++ 	for (i = 0; i < data->num_map; i++) {
+++ 		snprintf(property, PROPERTY_MAXSIZE, "page%d", i);
+++-		rc = of_property_read_u32_array(node, property,
++++		rc = cam_eeprom_read_u32_array_prop(node, property,
+++ 			(uint32_t *) &map[i].page, count);
+++ 		if (rc < 0) {
+++ 			CAM_ERR(CAM_EEPROM, "failed: page not available rc %d",
+++@@ -153,19 +185,19 @@ int cam_eeprom_parse_dt_memory_map(struct device_node *node,
+++ 		}
+++ 
+++ 		snprintf(property, PROPERTY_MAXSIZE, "pageen%d", i);
+++-		rc = of_property_read_u32_array(node, property,
++++		rc = cam_eeprom_read_u32_array_prop(node, property,
+++ 			(uint32_t *) &map[i].pageen, count);
+++ 		if (rc < 0)
+++ 			CAM_DBG(CAM_EEPROM, "pageen not needed");
+++ 
+++ 		snprintf(property, PROPERTY_MAXSIZE, "saddr%d", i);
+++-		rc = of_property_read_u32_array(node, property,
++++		rc = cam_eeprom_read_u32_array_prop(node, property,
+++ 			(uint32_t *) &map[i].saddr, 1);
+++ 		if (rc < 0)
+++ 			CAM_DBG(CAM_EEPROM, "saddr not needed - block %d", i);
+++ 
+++ 		snprintf(property, PROPERTY_MAXSIZE, "poll%d", i);
+++-		rc = of_property_read_u32_array(node, property,
++++		rc = cam_eeprom_read_u32_array_prop(node, property,
+++ 			(uint32_t *) &map[i].poll, count);
+++ 		if (rc < 0) {
+++ 			CAM_ERR(CAM_EEPROM, "failed: poll not available rc %d",
+++@@ -174,7 +206,7 @@ int cam_eeprom_parse_dt_memory_map(struct device_node *node,
+++ 		}
+++ 
+++ 		snprintf(property, PROPERTY_MAXSIZE, "mem%d", i);
+++-		rc = of_property_read_u32_array(node, property,
++++		rc = cam_eeprom_read_u32_array_prop(node, property,
+++ 			(uint32_t *) &map[i].mem, count);
+++ 		if (rc < 0) {
+++ 			CAM_ERR(CAM_EEPROM, "failed: mem not available rc %d",
++diff --git a/patch+++/0030-media-cam_sensor-Accept-a-one-byte-sensor-id.patch b/patch+++/0030-media-cam_sensor-Accept-a-one-byte-sensor-id.patch
++new file mode 100755
++index 000000000..a7814184d
++--- /dev/null
+++++ b/patch+++/0030-media-cam_sensor-Accept-a-one-byte-sensor-id.patch
++@@ -0,0 +1,64 @@
+++From 0dafae42b4dba68f3db75450c0a25f0cf8774a84 Mon Sep 17 00:00:00 2001
+++From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++Date: Sun, 13 Sep 2026 11:26:49 +0800
+++Subject: [PATCH 30/40] media: cam_sensor: Accept a one byte sensor id
+++
+++The front camera never finished its probe:
+++
+++  CAM_ERR: CAM-SENSOR: cam_sensor_match_id: 643 chip id 5616 does not match 56
+++
+++and the provider therefore only ever saw the rear camera.  The register really
+++does read back 0x5616 - that is the OV16A10 id - but the userspace declares the
+++id as a single byte, 0x56, because on the factory kernel that is what the read
+++returns: the factory driver hands camera_io_dev_read() the address and data types
+++that come from userspace (the addr_type and data_type of the sensor board info),
+++while this tree hardcodes CAMERA_SENSOR_I2C_TYPE_WORD for both, so a byte sized
+++register read became a word sized one and the comparison could never match.
+++
+++Accept the leading byte of the read value, and log it explicitly, so the front
+++sensor passes its probe the way it does on the factory kernel.  0x5616 >> 8 is
+++0x56, exactly the declared id; the rear camera keeps matching by its full id
+++(0x30c6) and therefore takes the unchanged path.
+++
+++Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++---
+++ .../cam_sensor/cam_sensor_core.c              | 26 ++++++++++++++++---
+++ 1 file changed, 23 insertions(+), 3 deletions(-)
+++
+++diff --git a/drivers/media/platform/msm/camera/cam_sensor_module/cam_sensor/cam_sensor_core.c b/drivers/media/platform/msm/camera/cam_sensor_module/cam_sensor/cam_sensor_core.c
+++index 7d048b982..cb04da983 100644
+++--- a/drivers/media/platform/msm/camera/cam_sensor_module/cam_sensor/cam_sensor_core.c
++++++ b/drivers/media/platform/msm/camera/cam_sensor_module/cam_sensor/cam_sensor_core.c
+++@@ -639,9 +639,29 @@ int cam_sensor_match_id(struct cam_sensor_ctrl_t *s_ctrl)
+++ 	CAM_DBG(CAM_SENSOR, "read id: 0x%x expected id 0x%x:",
+++ 			 chipid, slave_info->sensor_id);
+++ 	if (cam_sensor_id_by_mask(s_ctrl, chipid) != slave_info->sensor_id) {
+++-		CAM_ERR(CAM_SENSOR, "chip id %x does not match %x",
+++-				chipid, slave_info->sensor_id);
+++-		return -ENODEV;
++++		/*
++++		 * EEBBK S6 (P20H130): the userspace declares a single byte id for
++++		 * the front camera (ov16a10: sensor_id 0x56) while its id register
++++		 * reads back 0x5616 over the word sized read this driver performs.
++++		 * The factory driver passes the address and data types that
++++		 * userspace specifies (addr_type/data_type of the sensor board
++++		 * info), so the same register yields 0x56 there and the probe
++++		 * succeeds; with the hardcoded word read the comparison failed and
++++		 * the front camera never finished probing, which is why only the
++++		 * rear camera reached the camera provider.
++++		 *
++++		 * Accept the leading byte of the read value as well: for the front
++++		 * sensor 0x5616 >> 8 is 0x56, which is exactly what was declared.
++++		 */
++++		if ((chipid >> 8) != slave_info->sensor_id &&
++++		    (chipid & 0xff) != slave_info->sensor_id) {
++++			CAM_ERR(CAM_SENSOR, "chip id %x does not match %x",
++++					chipid, slave_info->sensor_id);
++++			return -ENODEV;
++++		}
++++		CAM_INFO(CAM_SENSOR,
++++			 "chip id %x matched by its leading byte, expected %x",
++++			 chipid, slave_info->sensor_id);
+++ 	}
+++ 	return rc;
+++ }
++diff --git a/patch+++/0031-misc-gpio_pwm-Never-sleep-in-the-move-timer-callback.patch b/patch+++/0031-misc-gpio_pwm-Never-sleep-in-the-move-timer-callback.patch
++new file mode 100755
++index 000000000..61fb43e2c
++--- /dev/null
+++++ b/patch+++/0031-misc-gpio_pwm-Never-sleep-in-the-move-timer-callback.patch
++@@ -0,0 +1,209 @@
+++From bd82954028e29ef5024ab35b555ca705669fe70e Mon Sep 17 00:00:00 2001
+++From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++Date: Sun, 13 Sep 2026 11:50:00 +0800
+++Subject: [PATCH 31/40] misc: gpio_pwm: Never sleep in the move timer callback
+++
+++Switching to the front camera froze the whole device.  The captured kernel log
+++shows why, and it is this driver:
+++
+++    bad: scheduling from the idle thread!
+++    CPU: 3 PID: 0 Comm: swapper/3
+++    Call trace:
+++      schedule_timeout
+++      msleep                       <- sleeping in interrupt context
+++      vib_pwm_brake
+++      vib_pwm_finish_move
+++      vib_pwm_timer_func           <- the hrtimer callback
+++      __hrtimer_run_queues
+++      hrtimer_interrupt
+++      ...
+++      lpm_cpuidle_enter / do_idle
+++
+++The hrtimer callback ran the whole stop path, and that path sleeps: the brake
+++performs the vendor's 5 ms delay with msleep(), clk_unprepare() may sleep, the
+++second stage's clk_set_rate() may sleep, and the hall framework calls
+++cancel_delayed_work_sync().  Sleeping there corrupted the scheduler state, the
+++emmc driver then timed out ("pwr ctrl cmd 0x18 ... completion timeout"), and the
+++device stopped responding to adb altogether.
+++
+++The vendor never does this: its hrtimer handler stops the waveform with three
+++gpio writes and clk_disable and queues its work one jiffy later, and every
+++sleeping step happens in that work (delay_func).  Split it the same way here:
+++
+++  vib_pwm_timer_func    three gpio writes plus clk_disable, then schedule_work()
+++  vib_pwm_finish_work   the brake with its 5 ms delay, clk_unprepare, the hall
+++                        queue resets, the camera state update and, for a two
+++                        stage move, the second stage's clk_set_rate
+++
+++Every caller that runs in process context now cancels the pending work before it
+++finishes a move itself, and a new move drops a stale finish so that it cannot
+++overwrite the state of the move that just started.
+++
+++The hall framework gets the matching fix: its worker re-armed itself
+++unconditionally, so cancel_delayed_work_sync() in the disable path could wait for
+++a work that kept re-scheduling itself, a livelock reached from the elevator
+++driver on every move.  It now re-arms only while the framework is still enabled.
+++
+++Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++---
+++ drivers/input/hall/bbk_hall_core.c | 12 +++++-
+++ drivers/misc/gpio_pwm.c            | 60 +++++++++++++++++++++++++++---
+++ 2 files changed, 65 insertions(+), 7 deletions(-)
+++
+++diff --git a/drivers/input/hall/bbk_hall_core.c b/drivers/input/hall/bbk_hall_core.c
+++index 19c35a04b..eade34595 100755
+++--- a/drivers/input/hall/bbk_hall_core.c
++++++ b/drivers/input/hall/bbk_hall_core.c
+++@@ -581,8 +581,16 @@ static void bbk_hal_work_func(struct work_struct *work)
+++ 	}
+++ 
+++ resched:
+++-	queue_delayed_work_on(8 /* WORK_CPU_UNBOUND */, system_wq, &d->work,
+++-			      msecs_to_jiffies(d->delay));
++++	/*
++++	 * Only re-arm while the framework is still enabled.  The disable path
++++	 * clears the flag before it cancels, so a self requeue here would make
++++	 * cancel_delayed_work_sync() wait for a work that keeps re-scheduling
++++	 * itself - a livelock that hangs whoever called enable(0), which is the
++++	 * elevator driver on every move.
++++	 */
++++	if (atomic_read(&d->enabled))
++++		queue_delayed_work_on(8 /* WORK_CPU_UNBOUND */, system_wq,
++++				      &d->work, msecs_to_jiffies(d->delay));
+++ }
+++ 
+++ /* [RE] enable is idempotent through an atomic compare and swap */
+++diff --git a/drivers/misc/gpio_pwm.c b/drivers/misc/gpio_pwm.c
+++index c28351468..296793337 100755
+++--- a/drivers/misc/gpio_pwm.c
++++++ b/drivers/misc/gpio_pwm.c
+++@@ -223,6 +223,14 @@ struct vib_pwm {
+++ 	bool			ws_active;
+++ 	wait_queue_head_t	wait;
+++ 	struct hrtimer		timer;
++++	/*
++++	 * [RE] the vendor's hrtimer handler only stops the electrical part and
++++	 * queues its work one jiffy later; the work does everything that may
++++	 * sleep.  Splitting it is not cosmetic: sleeping inside the hrtimer
++++	 * callback corrupts the kernel ("bad: scheduling from the idle thread!"
++++	 * with msleep <- vib_pwm_brake <- vib_pwm_timer_func in the trace).
++++	 */
++++	struct work_struct	finish_work;
+++ 	/* move state */
+++ 	unsigned int		time_ms;
+++ 	unsigned int		pre_time;
+++@@ -344,6 +352,9 @@ static int vib_pwm_set_camera_state(struct vib_pwm *d)
+++ 		return 0;
+++ 	}
+++ 
++++	/* drop a finish that is still pending: it belongs to the previous move */
++++	cancel_work_sync(&d->finish_work);
++++
+++ 	if (!d->ws_active) {
+++ 		__pm_stay_awake(&d->wakeup);
+++ 		d->ws_active = true;
+++@@ -404,6 +415,21 @@ static void vib_pwm_stage2(struct vib_pwm *d)
+++ 	hrtimer_start(&d->timer, vib_pwm_ms_to_ktime(ms), HRTIMER_MODE_REL_PINNED);
+++ }
+++ 
++++/*
++++ * [RE] stop the waveform and the driver from interrupt context: three gpio
++++ * writes and clk_disable, exactly the steps the vendor's hrtimer handler does.
++++ * The vendor's 5 ms brake delay, clk_unprepare, the hall framework calls and the
++++ * second stage all belong to the deferred work, because they may sleep.
++++ */
++++static void vib_pwm_stop_waveform(struct vib_pwm *d)
++++{
++++	d->is_move = false;
++++	clk_disable(d->gp2_clk);
++++	vib_pwm_gpio_set(d->boost_gpio, 0);
++++	vib_pwm_gpio_set(d->enable_gpio, 1);
++++	vib_pwm_gpio_set(d->sleep_gpio, 0);
++++}
++++
+++ /* stop the electrical part of a move; must not cancel the timer */
+++ static void vib_pwm_motor_down(struct vib_pwm *d)
+++ {
+++@@ -447,23 +473,42 @@ static void vib_pwm_finish_move(struct vib_pwm *d, bool keep_state)
+++ 		 __func__, d->camera_state);
+++ }
+++ 
++++/*
++++ * [RE] the vendor's handler: stop what can be stopped without sleeping and hand
++++ * the rest to the work.  Nothing here may sleep - no msleep, no clk_unprepare,
++++ * no clk_set_rate, no cancel of another work.
++++ */
+++ static enum hrtimer_restart vib_pwm_timer_func(struct hrtimer *timer)
+++ {
+++ 	struct vib_pwm *d = container_of(timer, struct vib_pwm, timer);
+++ 
+++ 	if (d->is_subsection) {
+++-		/* the preliminary 50 ms stage, then the fast second stage */
++++		/* the preliminary stage is over: the second stage's clk_set_rate
++++		 * may sleep, so it runs in the work */
+++ 		dev_info(d->dev,
+++ 			 "++++++++++++ %s: is_subsection = true & wait_up_interrupt to start next vib_freq\n",
+++ 			 __func__);
+++-		vib_pwm_stage2(d);
++++		schedule_work(&d->finish_work);
+++ 		return HRTIMER_NORESTART;
+++ 	}
+++ 
+++-	d->is_move = false;
++++	vib_pwm_stop_waveform(d);
++++	schedule_work(&d->finish_work);
++++	return HRTIMER_NORESTART;
++++}
++++
++++/* the deferred half: everything that may sleep */
++++static void vib_pwm_finish_work(struct work_struct *work)
++++{
++++	struct vib_pwm *d = container_of(work, struct vib_pwm, finish_work);
++++
++++	if (d->is_subsection) {
++++		vib_pwm_stage2(d);
++++		return;
++++	}
++++
+++ 	vib_pwm_finish_move(d, false);
+++ 	wake_up_interruptible(&d->wait);
+++-	return HRTIMER_NORESTART;
+++ }
+++ 
+++ /* ------------------------------------------------------ state machine ---- */
+++@@ -597,6 +642,7 @@ void cancel_vib_hrtimer(int arg)
+++ 	if (!d)
+++ 		return;
+++ 	hrtimer_cancel(&d->timer);
++++	cancel_work_sync(&d->finish_work);
+++ 	bbk_hall_core_init_queue();
+++ 	bbk_hall_core_init_move_queue();
+++ 	vib_pwm_finish_move(d, true);
+++@@ -713,8 +759,10 @@ static ssize_t vib_pwm_enable_store(struct device *dev, struct device_attribute
+++ 
+++ 	mutex_lock(&d->lock);
+++ 	d->enable = (v == 1 || v == 2) ? v : 0;
+++-	if (d->enable == 0)
++++	if (d->enable == 0) {
+++ 		hrtimer_cancel(&d->timer);
++++		cancel_work_sync(&d->finish_work);
++++	}
+++ 	vib_pwm_set_camera_state(d);
+++ 	mutex_unlock(&d->lock);
+++ 	return count;
+++@@ -1200,6 +1248,7 @@ static int vib_pwm_probe(struct platform_device *pdev)
+++ 	wakeup_source_init(&d->wakeup, "vib_wake_lock");
+++ 	hrtimer_init(&d->timer, CLOCK_MONOTONIC, HRTIMER_MODE_REL_PINNED);
+++ 	d->timer.function = vib_pwm_timer_func;
++++	INIT_WORK(&d->finish_work, vib_pwm_finish_work);
+++ 
+++ 	ret = vib_pwm_input_init(d);
+++ 	if (ret)
+++@@ -1237,6 +1286,7 @@ static int vib_pwm_remove(struct platform_device *pdev)
+++ 
+++ 	if (d) {
+++ 		hrtimer_cancel(&d->timer);
++++		cancel_work_sync(&d->finish_work);
+++ 		vib_pwm_brake(d);
+++ 		wakeup_source_destroy(&d->wakeup);
+++ 		sysfs_remove_groups(&pdev->dev.kobj, vib_pwm_groups);
++diff --git a/patch+++/0032-misc-gpio_pwm-Select-the-pinmux-state-around-every-m.patch b/patch+++/0032-misc-gpio_pwm-Select-the-pinmux-state-around-every-m.patch
++new file mode 100755
++index 000000000..a709ef115
++--- /dev/null
+++++ b/patch+++/0032-misc-gpio_pwm-Select-the-pinmux-state-around-every-m.patch
++@@ -0,0 +1,107 @@
+++From c82a07961d863bfee7a6a99608afdaac13f6effa Mon Sep 17 00:00:00 2001
+++From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++Date: Sun, 13 Sep 2026 11:59:39 +0800
+++Subject: [PATCH 32/40] misc: gpio_pwm: Select the pinmux state around every
+++ move
+++
+++With the front camera finally enumerated and the hang gone, the elevator still
+++did not move: the driver ran its whole sequence (the log shows "want 1, current
+++0 -> up for 1941 ms", the move finished and the 645/646 key events were injected)
+++but the mechanism stayed put, so the motor was getting no waveform.
+++
+++The cause is the pinmux.  The device tree gives this driver three pinctrl states:
+++"vib_pwm_active" muxes gpio21 to the gcc_gp2 clock output, "vib_pwm_suspend"
+++turns it back into a pulled down gpio, and "vib_pwm_idconfig" configures the id
+++strap on gpio25.  pinctrl_select_state() replaces the selected state rather than
+++adding to it, and the probe selected active and then idconfig, which dropped the
+++gpio21 mux again - so the general purpose clock never reached the motor driver
+++and nothing moved, however correct the rest of the sequence was.
+++
+++Select the id strap state for the module id read and leave the pins idle after
+++the probe, select "active" before every move and "suspend" once the move is over,
+++and log which one was selected so the next bring-up round can see it.
+++
+++Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++---
+++ drivers/misc/gpio_pwm.c | 38 ++++++++++++++++++++++++++++++++++++--
+++ 1 file changed, 36 insertions(+), 2 deletions(-)
+++
+++diff --git a/drivers/misc/gpio_pwm.c b/drivers/misc/gpio_pwm.c
+++index 296793337..6e791e1ba 100755
+++--- a/drivers/misc/gpio_pwm.c
++++++ b/drivers/misc/gpio_pwm.c
+++@@ -295,6 +295,33 @@ static void vib_pwm_gpio_input(int gpio)
+++ 		gpiod_direction_input(gpio_to_desc(gpio));
+++ }
+++ 
++++/*
++++ * [RE] the device tree carries three pinctrl states for this driver:
++++ * "vib_pwm_active" muxes gpio21 to the gcc_gp2 clock output, "vib_pwm_suspend"
++++ * turns it back into a pulled down gpio and "vib_pwm_idconfig" configures the id
++++ * strap on gpio25.  pinctrl_select_state() *replaces* the selected state, so
++++ * leaving idconfig selected after the probe also dropped the clock mux and the
++++ * motor received no waveform at all: the driver ran its whole move sequence
++++ * while the elevator never moved.  Select active for a move and suspend after
++++ * it, which is what these two states exist for.
++++ */
++++static void vib_pwm_select_pins(struct vib_pwm *d, bool active)
++++{
++++	struct pinctrl_state *state;
++++
++++	if (IS_ERR_OR_NULL(d->pinctrl))
++++		return;
++++	state = active ? d->pins_active : d->pins_suspend;
++++	if (IS_ERR_OR_NULL(state))
++++		return;
++++	if (pinctrl_select_state(d->pinctrl, state))
++++		dev_err(d->dev, "%s: cannot select the %s pinctrl state\n",
++++			__func__, active ? "active" : "suspend");
++++	else
++++		dev_info(d->dev, "%s: pinctrl %s\n", __func__,
++++			 active ? "active" : "suspend");
++++}
++++
+++ static void vib_pwm_brake(struct vib_pwm *d)
+++ {
+++ 	/* [RE] boost = 0, msleep(5), enable = 1, sleep = 0; dir is not touched */
+++@@ -355,6 +382,9 @@ static int vib_pwm_set_camera_state(struct vib_pwm *d)
+++ 	/* drop a finish that is still pending: it belongs to the previous move */
+++ 	cancel_work_sync(&d->finish_work);
+++ 
++++	/* mux gpio21 back to the gcc_gp2 clock output before driving */
++++	vib_pwm_select_pins(d, true);
++++
+++ 	if (!d->ws_active) {
+++ 		__pm_stay_awake(&d->wakeup);
+++ 		d->ws_active = true;
+++@@ -447,6 +477,7 @@ static void vib_pwm_motor_down(struct vib_pwm *d)
+++ static void vib_pwm_finish_move(struct vib_pwm *d, bool keep_state)
+++ {
+++ 	vib_pwm_motor_down(d);
++++	vib_pwm_select_pins(d, false);
+++ 	d->move_count = 0;
+++ 
+++ 	if (d->target_state <= CAM_STATE_FULL) {
+++@@ -508,6 +539,7 @@ static void vib_pwm_finish_work(struct work_struct *work)
+++ 	}
+++ 
+++ 	vib_pwm_finish_move(d, false);
++++	vib_pwm_select_pins(d, false);
+++ 	wake_up_interruptible(&d->wait);
+++ }
+++ 
+++@@ -1239,10 +1271,12 @@ static int vib_pwm_probe(struct platform_device *pdev)
+++ 		d->pins_active = pinctrl_lookup_state(d->pinctrl, "vib_pwm_active");
+++ 		d->pins_suspend = pinctrl_lookup_state(d->pinctrl, "vib_pwm_suspend");
+++ 		d->pins_idconfig = pinctrl_lookup_state(d->pinctrl, "vib_pwm_idconfig");
+++-		if (!IS_ERR(d->pins_active))
+++-			pinctrl_select_state(d->pinctrl, d->pins_active);
++++		/* read the id strap first, then leave the pins in their idle
++++		 * state; a move selects the active state again */
+++ 		if (!IS_ERR(d->pins_idconfig))
+++ 			pinctrl_select_state(d->pinctrl, d->pins_idconfig);
++++		if (!IS_ERR(d->pins_suspend))
++++			pinctrl_select_state(d->pinctrl, d->pins_suspend);
+++ 	}
+++ 
+++ 	wakeup_source_init(&d->wakeup, "vib_wake_lock");
++diff --git a/patch+++/0033-clk-qcom-gcc-sdmmagpie-Restore-the-low-frequency-GP-.patch b/patch+++/0033-clk-qcom-gcc-sdmmagpie-Restore-the-low-frequency-GP-.patch
++new file mode 100755
++index 000000000..afb382091
++--- /dev/null
+++++ b/patch+++/0033-clk-qcom-gcc-sdmmagpie-Restore-the-low-frequency-GP-.patch
++@@ -0,0 +1,78 @@
+++From 7f916bc91a8438a01c704edc8f17151b6e7e7bfa Mon Sep 17 00:00:00 2001
+++From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++Date: Sun, 13 Sep 2026 12:47:59 +0800
+++Subject: [PATCH 33/40] clk: qcom: gcc-sdmmagpie: Restore the low frequency GP
+++ clock entries
+++
+++The camera elevator chopper is gcc_gp2_clk, the branch of gcc_gp2_clk_src
+++behind <&gcc GCC_GP2_CLK>.  This tree carries the generic table for that RCG,
+++which only offers 19.2 MHz and up, so the clk_set_rate() the elevator driver
+++performs on the branch - the same call the vendor driver makes - silently
+++leaves the pin at 19.2 MHz.  A motor driver fed 19.2 MHz never switches its
+++outputs, so the mechanism only hummed and the front camera never came out: the
+++stock firmware had the same hole.
+++
+++The factory kernel's table for this RCG was recovered from the vmlinux symbol
+++data (three gcc_gp2_clk_src copies exist, one per compiled GCC driver; the
+++sdmmagpie one is the table in use on this board) and restored here.  All the low
+++entries run from bi_tcxo through the half integer divider h and the mnd ratio
+++m/n, so clk_rcg2_calc_rate() = (parent / h) * m / n gives
+++
+++    19200000 / 16 * 2 / 75  = 32000    a normal move
+++    19200000 / 16 * 4 / 250 = 19200    first stage of a long move
+++    19200000 / 15 * 8 / 246 = 41626    second stage of a long move
+++
+++which is exactly the set of rates drivers/misc/gpio_pwm.c asks for.  Verified
+++on the device: gcc_gp2_clk_src reports 32000 Hz during a move and the elevator
+++now raises the front camera.
+++
+++Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++---
+++ drivers/clk/qcom/gcc-sdmmagpie.c | 33 ++++++++++++++++++++++++++++++++
+++ 1 file changed, 33 insertions(+)
+++
+++diff --git a/drivers/clk/qcom/gcc-sdmmagpie.c b/drivers/clk/qcom/gcc-sdmmagpie.c
+++index 591d76fb0..46cfba5d0 100644
+++--- a/drivers/clk/qcom/gcc-sdmmagpie.c
++++++ b/drivers/clk/qcom/gcc-sdmmagpie.c
+++@@ -330,7 +330,40 @@ static struct clk_rcg2 gcc_cpuss_rbcpr_clk_src = {
+++ 	},
+++ };
+++ 
++++/*
++++ * [RE] Restored from the factory kernel: this table also carries the low
++++ * frequencies the EEBBK S6 camera elevator chopper runs at.  They all come from
++++ * bi_tcxo through the half integer divider h and the mnd ratio m/n, so with
++++ * clk_rcg2_calc_rate() = (parent / h) * m / n:
++++ *
++++ *     19200000 / 16 * 2 / 75  = 32000   a normal move
++++ *     19200000 / 16 * 4 / 250 = 19200   first stage of a long move
++++ *     19200000 / 15 * 8 / 246 = 41626   second stage of a long move
++++ *
++++ * which is exactly what drivers/misc/gpio_pwm.c asks for.  Without them the RCG
++++ * can only produce 19.2 MHz and up, clk_set_rate() on the gcc_gp2_clk branch
++++ * silently leaves the pin at 19.2 MHz, and the motor driver - which cannot
++++ * switch that fast - only hums: the elevator never moved, in this kernel or in
++++ * the vendor's own driver, which asks for the same three rates.
++++ */
+++ static const struct freq_tbl ftbl_gcc_gp1_clk_src[] = {
++++	F(4800, P_BI_TCXO, 16, 1, 250),
++++	F(8000, P_BI_TCXO, 16, 1, 150),
++++	F(9600, P_BI_TCXO, 16, 2, 250),
++++	F(10000, P_BI_TCXO, 16, 1, 120),
++++	F(10406, P_BI_TCXO, 15, 2, 246),
++++	F(12800, P_BI_TCXO, 10, 1, 150),
++++	F(16000, P_BI_TCXO, 16, 1, 75),
++++	F(19200, P_BI_TCXO, 16, 4, 250),
++++	F(20800, P_BI_TCXO, 15, 4, 246),
++++	F(25600, P_BI_TCXO, 10, 2, 150),
++++	F(28800, P_BI_TCXO, 16, 3, 125),
++++	F(32000, P_BI_TCXO, 16, 2, 75),
++++	F(38400, P_BI_TCXO, 8, 2, 125),
++++	F(40000, P_BI_TCXO, 16, 4, 120),
++++	F(41600, P_BI_TCXO, 15, 8, 246),
++++	F(48000, P_BI_TCXO, 16, 3, 75),
++++	F(64000, P_BI_TCXO, 16, 4, 75),
+++ 	F(19200000, P_BI_TCXO, 1, 0, 0),
+++ 	F(25000000, P_GPLL0_OUT_EVEN, 12, 0, 0),
+++ 	F(50000000, P_GPLL0_OUT_EVEN, 6, 0, 0),
++diff --git a/patch+++/0034-misc-gpio_pwm-Program-the-chopper-rate-on-the-parent.patch b/patch+++/0034-misc-gpio_pwm-Program-the-chopper-rate-on-the-parent.patch
++new file mode 100755
++index 000000000..4e8cd4a27
++--- /dev/null
+++++ b/patch+++/0034-misc-gpio_pwm-Program-the-chopper-rate-on-the-parent.patch
++@@ -0,0 +1,226 @@
+++From 7aad2dd81e7eaa3b4625035cf78447ad869ce524 Mon Sep 17 00:00:00 2001
+++From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++Date: Sun, 13 Sep 2026 12:47:59 +0800
+++Subject: [PATCH 34/40] misc: gpio_pwm: Program the chopper rate on the parent
+++ RCG and balance the clock
+++
+++clk_set_rate() on gcc_gp2_clk only reaches the divider through the parent RCG,
+++so set the parent's rate as well and log what the framework ends up with.  The
+++timer callback stops the waveform and the deferred work finishes the move, so
+++clk_disable()/clk_unprepare() ran twice on an already stopped clock and the
+++clock core warned at clk_core_disable() (drivers/clk/clk.c:903); track the
+++prepare and enable state in the driver and keep the calls balanced.
+++
+++The bring-up attribute vib_pwm_debug reports the requested and achieved chopper
+++rate, the parent clock, the pin levels and the move state; it is compiled in
+++only for CONFIG_BBK_DEBUG_BRINGUP.
+++
+++Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++---
+++ drivers/misc/gpio_pwm.c | 127 ++++++++++++++++++++++++++++++++++------
+++ 1 file changed, 109 insertions(+), 18 deletions(-)
+++
+++diff --git a/drivers/misc/gpio_pwm.c b/drivers/misc/gpio_pwm.c
+++index 6e791e1ba..55cd37aff 100755
+++--- a/drivers/misc/gpio_pwm.c
++++++ b/drivers/misc/gpio_pwm.c
+++@@ -87,6 +87,7 @@
+++ #include <linux/of_gpio.h>
+++ #include <linux/gpio.h>
+++ #include <linux/clk.h>
++++#include <linux/clk-provider.h>
+++ #include <linux/pinctrl/consumer.h>
+++ #include <linux/hrtimer.h>
+++ #include <linux/ktime.h>
+++@@ -257,6 +258,14 @@ struct vib_pwm {
+++ 	char			notify_str[32];
+++ 	/* key injection */
+++ 	struct input_dev	*input;
++++	/*
++++	 * The clock has to be tracked by hand: the timer callback stops the
++++	 * waveform and the deferred work then finishes the move, so without
++++	 * these flags clk_disable() runs twice and the clock core warns about
++++	 * an unbalanced disable (drivers/clk/clk.c:903).
++++	 */
++++	bool			clk_on;
++++	bool			clk_prepared;
+++ };
+++ 
+++ static struct vib_pwm *vib_pwm_dev;
+++@@ -351,6 +360,33 @@ static ktime_t vib_pwm_move_time(struct vib_pwm *d)
+++ 	return vib_pwm_ms_to_ktime(ms);
+++ }
+++ 
++++/*
++++ * The chopper frequency lives in the RCG behind the branch clock this driver
++++ * was given, so setting it on the branch alone does nothing: measured on the
++++ * device, the pin kept outputting 19.2 MHz whatever freq was written.  The
++++ * vendor has the same latent bug, which is why the stock kernel never moved the
++++ * elevator.  Program the parent and report what the framework ends up with.
++++ */
++++static void vib_pwm_set_clock(struct vib_pwm *d)
++++{
++++	struct clk *src = clk_get_parent(d->gp2_clk);
++++	int ret;
++++
++++	ret = clk_set_rate(d->gp2_clk, d->freq);
++++	if (ret)
++++		dev_err(d->dev, "%s: can't set pwm_clk rate ret=%d\n", __func__, ret);
++++
++++	if (src && !IS_ERR(src)) {
++++		ret = clk_set_rate(src, d->freq);
++++		if (ret)
++++			dev_err(d->dev, "%s: can't set %s rate ret=%d\n", __func__,
++++				__clk_get_name(src), ret);
++++		dev_info(d->dev, "%s: freq %lu, %s -> %lu Hz, branch %lu Hz\n",
++++			 __func__, d->freq, __clk_get_name(src),
++++			 clk_get_rate(src), clk_get_rate(d->gp2_clk));
++++	}
++++}
++++
+++ /*
+++  * [RE] vib_pwm_set_camera_state: program the clock, bring the driver up in the
+++  * order the vendor used and arm the move timer.  enable is 1 for up and 2 for
+++@@ -392,18 +428,11 @@ static int vib_pwm_set_camera_state(struct vib_pwm *d)
+++ 
+++ 	when = vib_pwm_move_time(d);
+++ 
+++-	ret = clk_set_rate(d->gp2_clk, d->freq);
+++-	if (ret < 0) {
+++-		dev_err(d->dev, "%s: can't set pwm_clk rate ret=%d\n", __func__, ret);
+++-		if (d->ws_active) {
+++-			__pm_relax(&d->wakeup);
+++-			d->ws_active = false;
+++-		}
+++-		return ret;
+++-	}
+++ 
+++ 	bbk_hall_core_enable(0);
+++ 	clk_prepare(d->gp2_clk);
++++	d->clk_prepared = true;
++++	vib_pwm_set_clock(d);
+++ 
+++ 	/* direction first: zero raises the elevator, one lowers it */
+++ 	vib_pwm_gpio_set(d->dir_gpio, d->enable == 1 ? 0 : 1);
+++@@ -414,6 +443,7 @@ static int vib_pwm_set_camera_state(struct vib_pwm *d)
+++ 	msleep(3);
+++ 
+++ 	clk_enable(d->gp2_clk);
++++	d->clk_on = true;
+++ 
+++ 	d->move_count++;
+++ 	hrtimer_start(&d->timer, when, HRTIMER_MODE_REL_PINNED);
+++@@ -430,12 +460,7 @@ static void vib_pwm_stage2(struct vib_pwm *d)
+++ 	int ret;
+++ 
+++ 	d->freq = VIB_PWM_FREQ_STAGE2;
+++-	ret = clk_set_rate(d->gp2_clk, d->freq);
+++-	if (ret < 0) {
+++-		dev_err(d->dev, "%s: can't set pwm_clk rate ret=%d\n", __func__, ret);
+++-		d->time_ms = 0;
+++-		return;
+++-	}
++++	vib_pwm_set_clock(d);
+++ 	ms = (d->time_ms - d->pre_time) * VIB_PWM_STAGE2_NUM / VIB_PWM_STAGE2_DEN;
+++ 	d->time_ms = ms;
+++ 	dev_info(d->dev,
+++@@ -454,7 +479,10 @@ static void vib_pwm_stage2(struct vib_pwm *d)
+++ static void vib_pwm_stop_waveform(struct vib_pwm *d)
+++ {
+++ 	d->is_move = false;
+++-	clk_disable(d->gp2_clk);
++++	if (d->clk_on) {
++++		clk_disable(d->gp2_clk);
++++		d->clk_on = false;
++++	}
+++ 	vib_pwm_gpio_set(d->boost_gpio, 0);
+++ 	vib_pwm_gpio_set(d->enable_gpio, 1);
+++ 	vib_pwm_gpio_set(d->sleep_gpio, 0);
+++@@ -464,8 +492,14 @@ static void vib_pwm_stop_waveform(struct vib_pwm *d)
+++ static void vib_pwm_motor_down(struct vib_pwm *d)
+++ {
+++ 	d->is_move = false;
+++-	clk_disable(d->gp2_clk);
+++-	clk_unprepare(d->gp2_clk);
++++	if (d->clk_on) {
++++		clk_disable(d->gp2_clk);
++++		d->clk_on = false;
++++	}
++++	if (d->clk_prepared) {
++++		clk_unprepare(d->gp2_clk);
++++		d->clk_prepared = false;
++++	}
+++ 	vib_pwm_brake(d);
+++ }
+++ 
+++@@ -1156,6 +1190,60 @@ static DEVICE_ATTR_RW(vib_pwm_cali);
+++ static DEVICE_ATTR_RW(vib_pwm_up_down_count);
+++ static DEVICE_ATTR_RW(vib_pwm_clear_cali_data);
+++ 
++++#ifdef CONFIG_BBK_DEBUG_BRINGUP
++++/*
++++ * Bring-up only.  The one thing that cannot be seen from userspace is the rate
++++ * the clock framework ends up programming for the chopper: the vendor sets
++++ * 32000 for a normal move, and because the travel is a pulse count a wrong rate
++++ * moves the elevator a wrong distance.
++++ */
++++static ssize_t vib_pwm_debug_show(struct device *dev,
++++				  struct device_attribute *attr, char *buf)
++++{
++++	struct vib_pwm *d = dev_get_drvdata(dev);
++++	struct clk *p = clk_get_parent(d->gp2_clk);
++++	int n;
++++
++++	n = sprintf(buf,
++++		    "freq=%d time_ms=%u enable=%d state=%d target=%d clk_on=%d clk_prepared=%d\n",
++++		    (int)d->freq, d->time_ms, d->enable, d->camera_state,
++++		    d->target_state, d->clk_on, d->clk_prepared);
++++	n += sprintf(buf + n,
++++		     "gp2_clk rate=%lu round(%d)=%ld enabled=%d parent=%s parent_rate=%lu\n",
++++		     clk_get_rate(d->gp2_clk), (int)d->freq,
++++		     clk_round_rate(d->gp2_clk, d->freq),
++++		     __clk_is_enabled(d->gp2_clk),
++++		     (p && !IS_ERR(p)) ? __clk_get_name(p) : "?",
++++		     (p && !IS_ERR(p)) ? clk_get_rate(p) : 0);
++++	n += sprintf(buf + n, "boost=%d en=%d sleep=%d dir=%d id=%d\n",
++++		     gpiod_get_raw_value(gpio_to_desc(d->boost_gpio)),
++++		     gpiod_get_raw_value(gpio_to_desc(d->enable_gpio)),
++++		     gpiod_get_raw_value(gpio_to_desc(d->sleep_gpio)),
++++		     gpiod_get_raw_value(gpio_to_desc(d->dir_gpio)),
++++		     gpiod_get_raw_value(gpio_to_desc(d->id_gpio)));
++++	return n;
++++}
++++
++++static ssize_t vib_pwm_debug_store(struct device *dev,
++++				   struct device_attribute *attr,
++++				   const char *buf, size_t count)
++++{
++++	struct vib_pwm *d = dev_get_drvdata(dev);
++++	unsigned int ms;
++++	int v;
++++
++++	if (sscanf(buf, "time %u", &ms) == 1)
++++		d->time_ms = ms;
++++	else if (sscanf(buf, "freq %d", &v) == 1)
++++		d->freq = v;
++++	else if (sscanf(buf, "round %d", &v) == 1)
++++		dev_info(d->dev, "%s: round_rate(%d) = %ld\n", __func__, v,
++++			 clk_round_rate(d->gp2_clk, v));
++++	return count;
++++}
++++static DEVICE_ATTR_RW(vib_pwm_debug);
++++#endif
++++
+++ static struct attribute *vib_pwm_attrs[] = {
+++ 	&dev_attr_vib_pwm_id.attr,
+++ 	&dev_attr_vib_pwm_freq.attr,
+++@@ -1172,6 +1260,9 @@ static struct attribute *vib_pwm_attrs[] = {
+++ 	&dev_attr_vib_pwm_cali.attr,
+++ 	&dev_attr_vib_pwm_up_down_count.attr,
+++ 	&dev_attr_vib_pwm_clear_cali_data.attr,
++++#ifdef CONFIG_BBK_DEBUG_BRINGUP
++++	&dev_attr_vib_pwm_debug.attr,
++++#endif
+++ 	NULL,
+++ };
+++ ATTRIBUTE_GROUPS(vib_pwm);
++diff --git a/patch+++/0035-input-misc-mxm1120-Decode-the-sample-and-read-the-id.patch b/patch+++/0035-input-misc-mxm1120-Decode-the-sample-and-read-the-id.patch
++new file mode 100755
++index 000000000..5bff22801
++--- /dev/null
+++++ b/patch+++/0035-input-misc-mxm1120-Decode-the-sample-and-read-the-id.patch
++@@ -0,0 +1,192 @@
+++From d2d844e8abcba22f4f680d257c8f62a63c1a3c4c Mon Sep 17 00:00:00 2001
+++From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++Date: Sun, 13 Sep 2026 12:47:59 +0800
+++Subject: [PATCH 35/40] input: misc: mxm1120: Decode the sample and read the id
+++ the way the factory does
+++
+++Two decoding errors made the hall sensors useless: the chip id was read from
+++register 0x00 (which holds the command written at probe, 0x40) instead of 0x09,
+++where both parts on this board answer 0x9c exactly as the factory probe
+++requires, and the measurement took bit 8 of the sample from register 0x00 rather
+++than from the third byte of the 0x10 block, which decoded every sample to the
+++constant 256.
+++
+++m1120_measure() now matches the factory's: read three bytes from register 0x10,
+++refuse the sample unless bit 0 of the first byte is set, take the value from
+++buf[1] plus bit 8 of buf[2] and sign extend it from bit 9 in the ten bit mode,
+++and report the refusal as -1, which the data attribute shows as -2000.  The dump
+++attribute prints the 0x10 block and the mode so the sensor can be checked from
+++userspace.
+++
+++Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++---
+++ drivers/input/misc/mxm1120.c | 93 +++++++++++++++++++++++++++---------
+++ 1 file changed, 70 insertions(+), 23 deletions(-)
+++
+++diff --git a/drivers/input/misc/mxm1120.c b/drivers/input/misc/mxm1120.c
+++index 2293e64a4..ecc534685 100644
+++--- a/drivers/input/misc/mxm1120.c
++++++ b/drivers/input/misc/mxm1120.c
+++@@ -84,20 +84,22 @@ extern void bbk_hall_core_unregister_device(struct hall_dev *dev);
+++ 
+++ #define M1120_DRV_NAME		"mxm1120"
+++ 
+++-#define M1120_REG_ID		0x00
++++#define M1120_REG_CMD		0x00
++++#define M1120_REG_CHIPID	0x09
+++ #define M1120_REG_CTRL1		0x01
+++ #define M1120_REG_CTRL2		0x07
+++ #define M1120_REG_OPMODE	0x08
+++ #define M1120_REG_DATA		0x10
+++ 
+++ /*
+++- * [RE] the factory driver's own id check compared against this value; on the
+++- * device both instances (i2c 0x0c and 0x0f) answer 0x41, which is what the
+++- * driver must accept.  A different value is only reported, because the part
+++- * may be a variant of the same family.
++++ * [RE] the factory probe reads one byte from register 0x09 and refuses the
++++ * part unless it is 0x9c; both instances on this board (i2c 0x0c and 0x0f)
++++ * answer 0x9c, which is what the earlier reconstruction got wrong when it
++++ * looked at register 0x00 instead.
+++  */
+++-#define M1120_ID_EXPECT		0x41
++++#define M1120_ID_EXPECT		0x9c
+++ #define M1120_DATA_LEN		3
++++#define M1120_DUMP_LEN		0x14
+++ #define M1120_OP_MEASUREMENT	0x40
+++ 
+++ enum m1120_pos {
+++@@ -165,7 +167,7 @@ static int m1120_read_block(struct m1120_data *d, u8 reg, u8 len, u8 *buf)
+++ 
+++ static int m1120_get_id(struct m1120_data *d, u8 *id)
+++ {
+++-	return m1120_read_block(d, M1120_REG_ID, 1, id);
++++	return m1120_read_block(d, M1120_REG_CHIPID, 1, id);
+++ }
+++ 
+++ static int m1120_init_device(struct m1120_data *d)
+++@@ -186,7 +188,7 @@ static int m1120_init_device(struct m1120_data *d)
+++ 			 "%s: device id 0x%02X, expected 0x%02X, continuing\n",
+++ 			 __func__, d->device_id, M1120_ID_EXPECT);
+++ 
+++-	ret = m1120_i2c_set_reg(d, M1120_REG_ID, 0x40);
++++	ret = m1120_i2c_set_reg(d, M1120_REG_CMD, 0x40);
+++ 	if (ret)
+++ 		return ret;
+++ 	ret = m1120_i2c_set_reg(d, M1120_REG_CTRL1, 0x00);
+++@@ -223,36 +225,43 @@ static int m1120_set_operation_mode(struct m1120_data *d, bool measure)
+++ 	return m1120_i2c_set_reg(d, M1120_REG_OPMODE, v);
+++ }
+++ 
+++-/* one measurement; returns the signed field value in *value */
++++/*
++++ * One measurement.  [RE] m1120_measure in the factory kernel reads three bytes
++++ * from register 0x10 and refuses the sample unless bit 0 of the first byte is
++++ * set; the caller turns that refusal into the value -2000.  The reading is
++++ * buf[1] plus bit 8 taken from the top bits of buf[2], sign extended from bit 9
++++ * in the 10 bit mode and a plain signed byte of buf[1] in the 8 bit mode.
++++ *
++++ * Reading the high bits from register 0x00 instead - as this driver first did -
++++ * returns a constant: register 0x00 holds 0x40, so every sample decoded to 256.
++++ */
+++ static int m1120_measure(struct m1120_data *d, s16 *value)
+++ {
+++ 	u8 buf[M1120_DATA_LEN];
+++-	u8 extra = 0;
+++ 	int v;
+++-
+++ 	int ret = m1120_read_block(d, M1120_REG_DATA, M1120_DATA_LEN, buf);
++++
+++ 	if (ret)
+++ 		return ret;
+++ 
+++-	/* [RE] "damon st1(0x%02X) is not DRDY" - bit 0 of the status byte */
+++-	if (!(buf[0] & 0x01))
++++	if (!(buf[0] & 0x01)) {
+++ 		dev_dbg(d->dev, "%s: damon st1(0x%02X) is not DRDY\n", __func__, buf[0]);
++++		return -1;
++++	}
+++ 
+++ 	if (d->ten_bit) {
+++-		/* [RE] 10-bit mode: low byte plus two bits from the status byte */
+++-		ret = m1120_read_block(d, M1120_REG_ID, 1, &extra);
+++-		if (ret)
+++-			return ret;
+++-		v = buf[1] | (((extra >> 6) & 0x3) << 8);
+++-		v = (v & 0x200) ? (v | ~0x3ff) : v;	/* sign extend bit 9 */
++++		v = buf[1] | (((buf[2] >> 6) & 0x1) << 8);
++++		if (buf[2] & 0x80)
++++			v |= ~0x3ff;			/* sign extend bit 9 */
+++ 	} else {
+++-		/* [RE] 8-bit mode */
+++-		v = buf[2] & 0x7f;
+++-		v = (buf[2] & 0x80) ? (v | ~0x7f) : v;	/* sign extend bit 7 */
++++		v = buf[1] & 0x7f;
++++		if (buf[1] & 0x80)
++++			v |= ~0x7f;			/* sign extend bit 7 */
+++ 	}
+++ 
+++ 	*value = (s16)v;
+++-	dev_dbg(d->dev, "%s: raw = %d\n", __func__, *value);
++++	dev_dbg(d->dev, "%s: raw = %d (st 0x%02x lo 0x%02x hi 0x%02x)\n",
++++		__func__, *value, buf[0], buf[1], buf[2]);
+++ 	return 0;
+++ }
+++ 
+++@@ -405,18 +414,56 @@ static ssize_t delay_store(struct device *dev, struct device_attribute *attr,
+++ 	return count;
+++ }
+++ 
++++/* [RE] the vendor's dump attribute: registers 0x00 to 0x13, byte by byte */
++++static ssize_t dump_show(struct device *dev, struct device_attribute *attr, char *buf)
++++{
++++	struct m1120_data *d = dev_get_drvdata(dev);
++++	u8 regs[M1120_DUMP_LEN];
++++	u8 blk[M1120_DATA_LEN];
++++	int i, n = 0, ret;
++++
++++	mutex_lock(&d->lock);
++++	for (i = 0; i < M1120_DUMP_LEN; i++) {
++++		ret = m1120_read_block(d, (u8)i, 1, &regs[i]);
++++		if (ret) {
++++			mutex_unlock(&d->lock);
++++			return scnprintf(buf, PAGE_SIZE,
++++					 "read reg 0x%02x failed (%d)\n", i, ret);
++++		}
++++	}
++++	mutex_unlock(&d->lock);
++++
++++	for (i = 0; i < M1120_DUMP_LEN; i++)
++++		n += scnprintf(buf + n, PAGE_SIZE - n, "[%02x]=%02x ", i, regs[i]);
++++	n += scnprintf(buf + n, PAGE_SIZE - n, "\n");
++++
++++	/* the block the measurement actually uses */
++++	mutex_lock(&d->lock);
++++	ret = m1120_read_block(d, M1120_REG_DATA, M1120_DATA_LEN, blk);
++++	mutex_unlock(&d->lock);
++++	if (!ret)
++++		n += scnprintf(buf + n, PAGE_SIZE - n,
++++			       "0x10 block: st=0x%02x lo=0x%02x hi=0x%02x ",
++++			       blk[0], blk[1], blk[2]);
++++	n += scnprintf(buf + n, PAGE_SIZE - n, "ten_bit=%d enabled=%d id=0x%02x\n",
++++		       d->ten_bit, d->enabled, d->device_id);
++++	return n;
++++}
++++
+++ static ssize_t vendor_show(struct device *dev, struct device_attribute *attr, char *buf)
+++ {
+++ 	return scnprintf(buf, PAGE_SIZE, "magnachip\n");
+++ }
+++ 
+++ static DEVICE_ATTR_RO(data);
++++static DEVICE_ATTR_RO(dump);
+++ static DEVICE_ATTR_RW(enable);
+++ static DEVICE_ATTR_RW(delay);
+++ static DEVICE_ATTR_RO(vendor);
+++ 
+++ static struct attribute *m1120_attrs[] = {
+++ 	&dev_attr_data.attr,
++++	&dev_attr_dump.attr,
+++ 	&dev_attr_enable.attr,
+++ 	&dev_attr_delay.attr,
+++ 	&dev_attr_vendor.attr,
++diff --git a/patch+++/0036-misc-bbk_debug-Make-the-log-node-filterable-and-add-.patch b/patch+++/0036-misc-bbk_debug-Make-the-log-node-filterable-and-add-.patch
++new file mode 100755
++index 000000000..cf74f4887
++--- /dev/null
+++++ b/patch+++/0036-misc-bbk_debug-Make-the-log-node-filterable-and-add-.patch
++@@ -0,0 +1,302 @@
+++From d630a0f48176f53485443d7b5c54d847e794db3d Mon Sep 17 00:00:00 2001
+++From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++Date: Sun, 13 Sep 2026 12:48:00 +0800
+++Subject: [PATCH 36/40] misc: bbk_debug: Make the log node filterable and add
+++ an elevator pin node
+++
+++The ring buffer on this ROM is flooded with SELinux audit records from adb shell
+++probing sysfs, so a plain snapshot of the oldest few kilobytes is useless.  The
+++log node now takes a pattern on write and returns only the matching lines, and
+++"clear" empties the buffer first, which is what makes a live capture of a
+++driver failure possible at all.
+++
+++/proc/eebbk_pins reports the electrical state that is otherwise invisible
+++without debugfs: the levels and directions of gpio 21/23/24/25/26/29 (the
+++elevator's clock output, enable, boost, id, direction and sleep pins) and the
+++rate of gcc_gp2_clk.  Both nodes exist only in CONFIG_BBK_DEBUG_BRINGUP builds.
+++
+++Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++---
+++ drivers/misc/bbk_debug.c | 221 +++++++++++++++++++++++++++++++++++----
+++ 1 file changed, 200 insertions(+), 21 deletions(-)
+++
+++diff --git a/drivers/misc/bbk_debug.c b/drivers/misc/bbk_debug.c
+++index f54277505..8be9d402d 100755
+++--- a/drivers/misc/bbk_debug.c
++++++ b/drivers/misc/bbk_debug.c
+++@@ -3,14 +3,20 @@
+++  *
+++  * On this ROM the kernel log is not readable from adb shell: /dev/kmsg is root
+++  * only, the syslog syscall is restricted and logd's kernel buffer is disabled,
+++- * so a driver that fails to probe leaves no trace we can see.  This node
+++- * publishes the whole ring buffer to any reader, which is what
++++ * so a driver that fails to probe leaves no trace we can see.  These nodes
++++ * publish the ring buffer and the state of the elevator pins to any reader,
++++ * which is what
+++  *
+++- *     adb shell cat /proc/eebbk_kmsg | grep -i m1120
++++ *     adb shell "echo clear > /proc/eebbk_kmsg"      # drop the audit spam
++++ *     adb shell "echo vib_pwm > /proc/eebbk_kmsg"    # keep only these lines
++++ *     adb shell cat /proc/eebbk_kmsg
+++  *
+++- * needs during bring-up.  It is compiled in only when CONFIG_BBK_DEBUG_BRINGUP
+++- * is set, together with the SELinux permissive override in
+++- * security/selinux/hooks.c, so the normal image is unaffected.
++++ * needs during bring-up.  Everything is compiled in only when
++++ * CONFIG_BBK_DEBUG_BRINGUP is set, together with the SELinux permissive
++++ * override in security/selinux/hooks.c, so the normal image is unaffected.
++++ *
++++ * The log node is world writable on purpose: adb shell is not root here, and
++++ * a 0600 node would be useless.  It exists in bring-up images only.
+++  *
+++  * SPDX-License-Identifier: GPL-2.0
+++  */
+++@@ -21,10 +27,19 @@
+++ #include <linux/fs.h>
+++ #include <linux/uaccess.h>
+++ #include <linux/syslog.h>
++++#include <linux/slab.h>
++++#include <linux/seq_file.h>
++++#include <linux/gpio.h>
++++#include <linux/gpio/consumer.h>
++++#include <linux/clk.h>
++++#include <linux/clk-provider.h>
+++ 
+++ #ifndef SYSLOG_ACTION_READ_ALL
+++ #define SYSLOG_ACTION_READ_ALL	3
+++ #endif
++++#ifndef SYSLOG_ACTION_READ_CLEAR
++++#define SYSLOG_ACTION_READ_CLEAR	4
++++#endif
+++ 
+++ /*
+++  * do_syslog()'s fourth argument.  check_syslog_permissions() lets a caller that
+++@@ -40,25 +55,139 @@
+++ #define SYSLOG_FROM_PROC	1
+++ #endif
+++ 
+++-#define BBK_KMSG_NAME	"eebbk_kmsg"
++++#define BBK_KMSG_NAME		"eebbk_kmsg"
++++#define BBK_PINS_NAME		"eebbk_pins"
+++ 
+++-static ssize_t bbk_kmsg_read(struct file *file, char __user *ubuf,
+++-			     size_t count, loff_t *ppos)
++++#define BBK_KMSG_MAX		(1024 * 1024)
++++#define BBK_KMSG_PATTERN_MAX	32
++++
++++static char *bbk_kmsg_buf;
++++static char bbk_kmsg_pattern[BBK_KMSG_PATTERN_MAX];
++++static DEFINE_MUTEX(bbk_kmsg_lock);
++++
++++/* reading the whole ring buffer through copy_to_user needs a kernel pointer */
++++static int bbk_kmsg_snapshot(char *dst, size_t size)
++++{
++++	mm_segment_t oldfs;
++++	int len;
++++
++++	oldfs = get_fs();
++++	set_fs(KERNEL_DS);
++++	len = do_syslog(SYSLOG_ACTION_READ_ALL, dst, size, SYSLOG_FROM_PROC);
++++	set_fs(oldfs);
++++	return len;
++++}
++++
++++static void bbk_kmsg_drop(void)
++++{
++++	mm_segment_t oldfs;
++++	char junk[256];
++++
++++	oldfs = get_fs();
++++	set_fs(KERNEL_DS);
++++	do_syslog(SYSLOG_ACTION_READ_CLEAR, junk, sizeof(junk), SYSLOG_FROM_PROC);
++++	set_fs(oldfs);
++++}
++++
++++/*
++++ * Writing a pattern selects which lines the next read returns; "clear" empties
++++ * the ring buffer so that the next read only shows what happened after it.
++++ */
++++static ssize_t bbk_kmsg_write(struct file *file, const char __user *ubuf,
++++			      size_t count, loff_t *ppos)
+++ {
+++-	int ret;
++++	char tmp[BBK_KMSG_PATTERN_MAX];
++++	size_t n = count;
+++ 
+++-	if (!count)
++++	if (!n)
+++ 		return 0;
++++	if (n > sizeof(tmp) - 1)
++++		n = sizeof(tmp) - 1;
++++	if (copy_from_user(tmp, ubuf, n))
++++		return -EFAULT;
++++	tmp[n] = 0;
++++	while (n && (tmp[n - 1] == '\n' || tmp[n - 1] == '\r'))
++++		tmp[--n] = 0;
++++
++++	mutex_lock(&bbk_kmsg_lock);
++++	if (!strcmp(tmp, "clear")) {
++++		bbk_kmsg_drop();
++++		bbk_kmsg_pattern[0] = 0;
++++	} else {
++++		memcpy(bbk_kmsg_pattern, tmp, n + 1);
++++	}
++++	mutex_unlock(&bbk_kmsg_lock);
++++	return count;
++++}
++++
++++static ssize_t bbk_kmsg_read(struct file *file, char __user *ubuf,
++++			     size_t count, loff_t *ppos)
++++{
++++	char line[1024];
++++	char pat[BBK_KMSG_PATTERN_MAX];
++++	char *r, *w, *end;
++++	int len, total, ret = 0;
+++ 
+++ 	/*
+++ 	 * READ_ALL always hands back the whole ring buffer, so without this a
+++ 	 * reader like cat would loop for ever.  One snapshot per open is what a
+++ 	 * bring-up node needs.
+++ 	 */
+++-	if (*ppos)
++++	if (!count || *ppos)
+++ 		return 0;
+++ 
+++-	ret = do_syslog(SYSLOG_ACTION_READ_ALL, ubuf, count, SYSLOG_FROM_PROC);
++++	mutex_lock(&bbk_kmsg_lock);
++++	if (!bbk_kmsg_buf) {
++++		/* 1 MB is too big for kmalloc on this device, so use vmalloc */
++++		bbk_kmsg_buf = vzalloc(BBK_KMSG_MAX);
++++		if (!bbk_kmsg_buf) {
++++			mutex_unlock(&bbk_kmsg_lock);
++++			return -ENOMEM;
++++		}
++++	}
++++	memcpy(pat, bbk_kmsg_pattern, sizeof(pat));
++++
++++	len = bbk_kmsg_snapshot(bbk_kmsg_buf, BBK_KMSG_MAX - 1);
++++	if (len < 0) {
++++		mutex_unlock(&bbk_kmsg_lock);
++++		return len;
++++	}
++++	bbk_kmsg_buf[len] = 0;
++++
++++	/* filter in place: the write cursor never passes the read cursor */
++++	r = bbk_kmsg_buf;
++++	w = bbk_kmsg_buf;
++++	end = bbk_kmsg_buf + len;
++++	while (r < end) {
++++		char *nl = memchr(r, '\n', end - r);
++++		size_t whole = nl ? (size_t)(nl - r) + 1 : (size_t)(end - r);
++++		size_t l = whole;
++++
++++		if (l > sizeof(line) - 1)
++++			l = sizeof(line) - 1;
++++		memcpy(line, r, l);
++++		line[l] = 0;
++++		if (!pat[0] || strstr(line, pat)) {
++++			memmove(w, r, whole);
++++			w += whole;
++++		}
++++		r += whole;
++++	}
++++
++++	total = w - bbk_kmsg_buf;
++++	if (total > (int)count) {
++++		/* hand back the newest lines that fit in the reader's buffer */
++++		int skip = total - (int)count;
++++
++++		memmove(bbk_kmsg_buf, bbk_kmsg_buf + skip, count);
++++		total = count;
++++	}
++++	if (total && copy_to_user(ubuf, bbk_kmsg_buf, total))
++++		ret = -EFAULT;
++++	else
++++		ret = total;
++++
++++	mutex_unlock(&bbk_kmsg_lock);
+++ 	if (ret > 0)
+++ 		*ppos += ret;
+++ 	return ret;
+++@@ -67,23 +196,73 @@ static ssize_t bbk_kmsg_read(struct file *file, char __user *ubuf,
+++ static const struct file_operations bbk_kmsg_fops = {
+++ 	.owner	= THIS_MODULE,
+++ 	.read	= bbk_kmsg_read,
++++	.write	= bbk_kmsg_write,
+++ 	.llseek	= no_llseek,
+++ };
+++ 
+++-static int __init bbk_debug_init(void)
++++/*
++++ * /proc/eebbk_pins - the electrical state of the elevator, which is otherwise
++++ * invisible: debugfs is not mounted and adb shell is not root.  The pins and
++++ * their polarity are the ones the device tree gives soc:bbk_vib_pwm; gpio21 is
++++ * the pin that carries the gcc_gp2 clock when the "vib_pwm_active" pinctrl
++++ * state is selected, which is how the motor gets its drive waveform.
++++ */
++++static int bbk_pins_show(struct seq_file *m, void *v)
+++ {
+++-	struct proc_dir_entry *e;
++++	static const int pins[] = { 21, 23, 24, 25, 26, 29 };
++++	struct clk *c;
++++	int i;
+++ 
+++-	e = proc_create(BBK_KMSG_NAME, 0444, NULL, &bbk_kmsg_fops);
+++-	if (!e) {
+++-		pr_err("bbk_debug: cannot create /proc/%s\n", BBK_KMSG_NAME);
+++-		return -ENOMEM;
++++	for (i = 0; i < ARRAY_SIZE(pins); i++) {
++++		struct gpio_desc *dsc = gpio_to_desc(pins[i]);
++++
++++		if (!dsc) {
++++			seq_printf(m, "gpio%-3d not a gpio here\n", pins[i]);
++++			continue;
++++		}
++++		seq_printf(m, "gpio%-3d raw=%d %s\n", pins[i],
++++			   gpiod_get_raw_value_cansleep(dsc),
++++			   gpiod_get_direction(dsc) ? "in" : "out");
+++ 	}
+++-	pr_info("bbk_debug: /proc/%s ready (bring-up build)\n", BBK_KMSG_NAME);
++++	seq_puts(m, "dir=26 (0 up, 1 down) enable=23 (0 on) boost=24 (1 on) "
++++		    "sleep=29 (1 on) id=25\n");
++++
++++	c = clk_get(NULL, "gcc_gp2_clk");
++++	if (IS_ERR(c)) {
++++		seq_printf(m, "gcc_gp2_clk not found (%ld)\n", PTR_ERR(c));
++++	} else {
++++		seq_printf(m, "gcc_gp2_clk rate=%lu enabled=%d\n",
++++			   clk_get_rate(c), __clk_is_enabled(c));
++++		clk_put(c);
++++	}
++++	return 0;
++++}
++++
++++static int bbk_pins_open(struct inode *inode, struct file *file)
++++{
++++	return single_open(file, bbk_pins_show, NULL);
++++}
++++
++++static const struct file_operations bbk_pins_fops = {
++++	.owner		= THIS_MODULE,
++++	.open		= bbk_pins_open,
++++	.read		= seq_read,
++++	.llseek		= seq_lseek,
++++	.release	= single_release,
++++};
++++
++++static int __init bbk_debug_init(void)
++++{
++++	if (!proc_create(BBK_KMSG_NAME, 0666, NULL, &bbk_kmsg_fops))
++++		pr_err("bbk_debug: cannot create /proc/%s\n", BBK_KMSG_NAME);
++++	if (!proc_create(BBK_PINS_NAME, 0444, NULL, &bbk_pins_fops))
++++		pr_err("bbk_debug: cannot create /proc/%s\n", BBK_PINS_NAME);
++++	pr_info("bbk_debug: /proc/%s and /proc/%s ready (bring-up build)\n",
++++		BBK_KMSG_NAME, BBK_PINS_NAME);
+++ 	return 0;
+++ }
+++ late_initcall(bbk_debug_init);
+++ 
+++ MODULE_AUTHOR("EEBBK S6 kernel reconstruction");
+++-MODULE_DESCRIPTION("Bring-up kernel log node for the EEBBK S6");
++++MODULE_DESCRIPTION("Bring-up kernel log and elevator pin nodes for the EEBBK S6");
+++ MODULE_LICENSE("GPL v2");
++diff --git a/patch+++/0037-media-cam_eeprom-Read-only-as-many-memory-map-values.patch b/patch+++/0037-media-cam_eeprom-Read-only-as-many-memory-map-values.patch
++new file mode 100755
++index 000000000..fe1299a25
++--- /dev/null
+++++ b/patch+++/0037-media-cam_eeprom-Read-only-as-many-memory-map-values.patch
++@@ -0,0 +1,55 @@
+++From 7771c5067af0c897a28839f6d9805df514f4c345 Mon Sep 17 00:00:00 2001
+++From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++Date: Sun, 13 Sep 2026 12:48:00 +0800
+++Subject: [PATCH 37/40] media: cam_eeprom: Read only as many memory map values
+++ as the tree provides
+++
+++The factory device tree gives six values for each memory map property while
+++MSM_EEPROM_MEM_MAP_PROPERTIES_CNT is eight, so reading eight returned -EINVAL
+++and cam_eeprom_parse_dt_memory_map tore the map down with "num-blocks/page not
+++available rc -22", which is why the front camera was never enumerated.  Count
+++what the property actually holds, cap it at the expected number and leave the
+++rest zero, and keep accepting both the qcom, prefixed and the bare name.
+++
+++Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+++---
+++ .../cam_eeprom/cam_eeprom_soc.c               | 24 ++++++++++++++++---
+++ 1 file changed, 21 insertions(+), 3 deletions(-)
+++
+++diff --git a/drivers/media/platform/msm/camera/cam_sensor_module/cam_eeprom/cam_eeprom_soc.c b/drivers/media/platform/msm/camera/cam_sensor_module/cam_eeprom/cam_eeprom_soc.c
+++index e8ab01cc2..b09c3aa7a 100644
+++--- a/drivers/media/platform/msm/camera/cam_sensor_module/cam_eeprom/cam_eeprom_soc.c
++++++ b/drivers/media/platform/msm/camera/cam_sensor_module/cam_eeprom/cam_eeprom_soc.c
+++@@ -144,11 +144,29 @@ static int cam_eeprom_read_u32_array_prop(struct device_node *node,
+++ 					  uint32_t count)
+++ {
+++ 	char property[PROPERTY_MAXSIZE];
++++	int  n;
+++ 
+++ 	snprintf(property, PROPERTY_MAXSIZE, "qcom,%s", name);
+++-	if (!of_property_read_u32_array(node, property, value, count))
+++-		return 0;
+++-	return of_property_read_u32_array(node, name, value, count);
++++	n = of_property_count_elems_of_size(node, property, sizeof(uint32_t));
++++	if (n <= 0) {
++++		snprintf(property, PROPERTY_MAXSIZE, "%s", name);
++++		n = of_property_count_elems_of_size(node, property,
++++						    sizeof(uint32_t));
++++	}
++++	if (n <= 0)
++++		return -EINVAL;
++++	if (n > (int)count)
++++		n = count;
++++
++++	/*
++++	 * EEBBK S6 (P20H130): the factory device tree gives six values per
++++	 * memory map property while MSM_EEPROM_MEM_MAP_PROPERTIES_CNT is eight,
++++	 * so asking for eight failed with -EINVAL ("failed: page not available
++++	 * rc -22") and the map was torn down.  Read what the tree actually
++++	 * provides; the remaining fields stay zero, which is what vzalloc()
++++	 * already produces and what the unused entries should be.
++++	 */
++++	return of_property_read_u32_array(node, property, value, n);
+++ }
