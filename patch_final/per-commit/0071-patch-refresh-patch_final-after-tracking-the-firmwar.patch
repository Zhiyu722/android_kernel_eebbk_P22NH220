+--+-	unsigned long		freq;		/* +400 */
+--+-	int			motor;		/* +412 */
+--+-	int			camera_state;	/* +416 */
+--+-	unsigned int		count;		/* +472 */
+--+-	int			is_in_cali;	/* +540 */
+--+-	bool			cam_up;
+--+-	/* user visible tuning values */
+--++	/* move state */
+--++	unsigned int		time_ms;
+--++	unsigned int		pre_time;
+--++	bool			is_subsection;
+--++	unsigned long		freq;
+--++	int			enable;		/* 1 up, 2 down, else idle */
+--++	int			camera_state;
+--++	int			target_state;
+--++	int			move_count;
