+++++
+++++	return sprintf(buf, "%u\n", d->count);
+++++}
+++++
+++++static ssize_t vib_pwm_count_store(struct device *dev, struct device_attribute *attr,
+++++				   const char *buf, size_t count)
+++++{
+++++	struct vib_pwm *d = dev_get_drvdata(dev);
+++++	int v;
+++++
+++++	if (kstrtoint(buf, 10, &v) == 0)
+++++		d->count = v;
