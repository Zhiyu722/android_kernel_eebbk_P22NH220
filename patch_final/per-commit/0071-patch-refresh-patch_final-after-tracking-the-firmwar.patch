+--+### 3.5 位置换算 `computer_distance(int diff, const struct hall_cali_data *c)` @0x8aa9ab0
+--+
+--+```c
+--+printk("…hall Cali_data position_0   up:%d, down:%d, up_down_diff: %d\n", c->p0.up, c->p0.down, c->p0.diff);  /* 同理 24/48/696/1 */
