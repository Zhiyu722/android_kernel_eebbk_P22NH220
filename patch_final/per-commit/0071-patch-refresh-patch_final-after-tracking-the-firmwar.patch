+++-+++	if (!d || !gpio_is_valid(d->id_gpio))
+++-+++		d->id = 0;
+++-+++	else
+++-+++		d->id = gpiod_get_raw_value(gpio_to_desc(d->id_gpio));
+++-+++
+++-+++	return sprintf(buf, "%d\n", d->id);
+++-+++}
+++-+++
+++-+++static ssize_t vib_pwm_frequency_show(struct device *dev, struct device_attribute *attr, char *buf)
+++-+++{
