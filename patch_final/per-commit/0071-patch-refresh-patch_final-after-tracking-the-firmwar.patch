+++#endif
+++	return error;''',
+++     'fs/stat.c newfstat ret')
+++
+++edit('fs/stat.c',
+++'''	int error = vfs_fstat(fd, &stat);
+++
+++	if (!error)
+++		error = cp_new_stat64(&stat, statbuf);
+++
+++	return error;''',
+++'''	int error = vfs_fstat(fd, &stat);
+++
+++	if (!error)
