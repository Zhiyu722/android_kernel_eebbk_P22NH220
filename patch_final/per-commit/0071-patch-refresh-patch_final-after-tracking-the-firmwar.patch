+index 000000000..e866c33ba
+--- /dev/null
++++ b/patch_final/per-commit/0034-misc-gpio_pwm-Program-the-chopper-rate-on-the-parent.patch
+@@ -0,0 +1,226 @@
++From 7aad2dd81e7eaa3b4625035cf78447ad869ce524 Mon Sep 17 00:00:00 2001
