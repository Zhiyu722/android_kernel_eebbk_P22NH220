+++    if (tgt == NULL) {
+++        pr_info("target type %s does not exist\n", t);
+++        return false;
+++    }
+++    cls = symtab_search(&db->p_classes, c);
+++    if (cls == NULL) {
+++        pr_info("class %s does not exist\n", c);
+++        return false;
+++    }
