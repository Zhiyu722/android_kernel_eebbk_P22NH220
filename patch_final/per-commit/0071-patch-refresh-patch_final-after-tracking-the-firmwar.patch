+-+++#### (10) `vib_pwm_holder_mode` 0664
+-+++```c
+-+++/* show */ return sprintf(buf, "%d\n", h->holder_mode);   /* 偏移 0x1B0 */
+-+++/* store */
+-+++printk("damon vib_pwm_holder_mode_store holder_mode *%s*\n", buf);
