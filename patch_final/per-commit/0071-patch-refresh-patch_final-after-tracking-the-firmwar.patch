+-++				    char *buf)
+-++{
+-++	struct mhall_data *d = mhall_data;
+-++	const char *up = (d && d->hall_up) ? d->hall_up->name : "none";
+-++	const char *down = (d && d->hall_down) ? d->hall_down->name : "none";
+-++
+-++	return sprintf(buf, "up:%s down:%s\n", up, down);
