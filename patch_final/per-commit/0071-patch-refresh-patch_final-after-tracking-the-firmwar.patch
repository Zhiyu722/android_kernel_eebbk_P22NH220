+++++	int (*get_data)(void *data, s16 *value);
+++++	int (*set_enable)(void *data, int on);
+++++};
+++++
+++++struct hall_dev {
+++++	char		name[24];
+++++	struct hall_ops	*ops;
+++++	void		*data;
+++++};
+++++
+++++extern int bbk_hall_core_register_device(struct hall_dev *dev);
+++++extern void bbk_hall_core_unregister_device(struct hall_dev *dev);
