+++int ksu_install_sulog_fd(void)
+++{
+++    struct file *filp;
+++    int fd;
+++
+++    mutex_lock(&ksu_sulog_fd_lock);
+++
+++    if (ksu_sulog_fd_active) {
+++        fd = -EBUSY;
+++        goto out_unlock;
+++    }
+++
+++    if (READ_ONCE(ksu_sulog_get_queue()->closed)) {
+++        fd = -EPIPE;
+++        goto out_unlock;
+++    }
