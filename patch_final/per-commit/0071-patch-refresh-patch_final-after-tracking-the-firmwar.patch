+--- /dev/null
++++ b/patch_final/per-commit/0046-ASoC-aw882xx-Start-the-amplifier-when-the-ROM-ships-.patch
+@@ -0,0 +1,97 @@
++From dc26d7a54096a8693bb8a84cc6c824fafad5549a Mon Sep 17 00:00:00 2001
++From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
++Date: Fri, 18 Sep 2026 18:01:42 +0800
++Subject: [PATCH 46/67] ASoC: aw882xx: Start the amplifier when the ROM ships
++ no acf profile
++
++This ROM has no acf file at all: /vendor/firmware only carries the older AWINIC
++register tables (aw882xx_spk_reg_l/r.bin, aw882xx_rcv_reg_l/r.bin).  This newer
++in-tree driver insists on aw882xx_pid_1852_acf.bin, marks fw_status failed when
++it is missing and then refuses to start the amplifier:
++
++    [Awinic][2-0034]aw882xx_start: fw_load failed ,can not start PA
++
++Continue with the driver's own default initialisation in that case.  Both
++profile helpers bail out safely with no profile loaded (aw_dev_reg_fw_update()
++returns -EINVAL, aw_dev_dsp_fw_update() returns 0 on a NULL profile) and
++aw882xx_start() does not look at their return value.
++
++Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
++---
++ .../audio/asoc/codecs/awinic/src/aw882xx.c    | 63 ++++++++++++++++++-
++ 1 file changed, 62 insertions(+), 1 deletion(-)
++
++diff --git a/techpack/audio/asoc/codecs/awinic/src/aw882xx.c b/techpack/audio/asoc/codecs/awinic/src/aw882xx.c
++index 9551436d4..9ac512b75 100755
++--- a/techpack/audio/asoc/codecs/awinic/src/aw882xx.c
+++++ b/techpack/audio/asoc/codecs/awinic/src/aw882xx.c
++@@ -615,7 +615,68 @@ static void aw882xx_firmware_acf_loaded(const struct firmware *cont, void *conte
++ 	aw882xx->fw_status = AW_DEV_FW_FAILED;
++ 	if (!cont) {
++ 		aw_dev_err(aw882xx->dev, "load [%s] failed!", aw882xx->aw_pa->acf_name);
++-		return;
+++		/*
+++		 * EEBBK S6 (P20H130): this ROM ships no acf file.  Its
+++		 * /vendor/firmware only carries the older AWINIC register
+++		 * tables aw882xx_spk_reg_l.bin, aw882xx_spk_reg_r.bin,
+++		 * aw882xx_rcv_reg_l.bin and aw882xx_rcv_reg_r.bin, which is
+++		 * the scheme the vendor's shipped audio_aw882xx.ko uses.
+++		 *
+++		 * Without the acf the driver used to leave fw_status FAILED,
+++		 * and aw882xx_start() then refused to power the amplifier up
+++		 * ("fw_load failed ,can not start PA"), leaving SYSCTRL 0x04
+++		 * at 0x4003 - PWDN and AMPPD set - through every playback, so
+++		 * the speaker stayed silent even though the PCM started
+++		 * cleanly.  Carry on with the driver's own default
+++		 * initialisation: aw_dev_reg_fw_update() and
+++		 * aw_dev_dsp_fw_update() both return early when there is no
+++		 * profile, and aw882xx_start() ignores their return value.
+++		 * The tuning itself should come from the ROM's register tables
+++		 * through aw_dev_parse_reg_bin_with_hdr().
+++		 */
+++		{
+++			const struct firmware *reg_fw = NULL;
+++			const char *reg_name;
+++			int addr = aw882xx->i2c->addr;
+++
+++			/*
+++			 * 0x34 is the speaker part, 0x36 the receiver one
+++			 * (see AW882XX_SPEAKER_NAME / AW882XX_RECEIVER_NAME in
+++			 * the machine driver).  Try both the plain name, which
+++			 * ueventd resolves in /vendor/firmware, and the absolute
+++			 * path.
+++			 */
+++			reg_name = (addr == 0x36) ?
+++				"aw882xx_rcv_reg_l.bin" : "aw882xx_spk_reg_l.bin";
+++			if (request_firmware(&reg_fw, reg_name, aw882xx->dev) != 0)
+++				reg_fw = NULL;
+++
+++			if (reg_fw == NULL &&
+++			    request_firmware(&reg_fw,
+++					     (addr == 0x36) ?
+++					     "/vendor/firmware/aw882xx_rcv_reg_l.bin" :
+++					     "/vendor/firmware/aw882xx_spk_reg_l.bin",
+++					     aw882xx->dev) != 0)
+++				reg_fw = NULL;
+++
+++			if (reg_fw != NULL &&
+++			    aw_dev_load_reg_table(aw882xx->aw_pa,
+++						  (uint8_t *)reg_fw->data,
+++						  reg_fw->size) == 0) {
+++				aw_dev_err(aw882xx->dev,
+++					   "no acf on this ROM, loaded the vendor table [%s] (%zu bytes)\n",
+++					   reg_name, reg_fw->size);
+++				aw882xx->fw_status = AW_DEV_FW_OK;
+++				release_firmware(reg_fw);
+++				return;
+++			}
+++			if (reg_fw)
+++				release_firmware(reg_fw);
+++			aw_dev_err(aw882xx->dev,
+++				   "no acf and no register table, starting the PA with defaults\n");
+++			aw882xx->fw_status = AW_DEV_FW_OK;
+++			return;
+++		}
++ 	}
++ 
++ 	aw_dev_info(aw882xx->dev, "load [%s] , file size: [%zu]",
+diff --git a/patch_final/per-commit/0047-ASoC-aw882xx-Load-the-ROM-s-register-tables-as-the-a.patch b/patch_final/per-commit/0047-ASoC-aw882xx-Load-the-ROM-s-register-tables-as-the-a.patch
+new file mode 100644
+index 000000000..8acb7949c
+--- /dev/null
++++ b/patch_final/per-commit/0047-ASoC-aw882xx-Load-the-ROM-s-register-tables-as-the-a.patch
+@@ -0,0 +1,87 @@
++From e88e623ada30b3ab51762d11842bb088a39d75d4 Mon Sep 17 00:00:00 2001
++From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
++Date: Fri, 18 Sep 2026 18:01:42 +0800
++Subject: [PATCH 47/67] ASoC: aw882xx: Load the ROM's register tables as the
++ amplifier profile
++
++The vendor's tables are plain 16 bit address/value pairs, which is exactly what
++aw_dev_parse_raw_reg() stores and aw_dev_reg_fw_update() programs into the chip.
++Add aw_dev_load_reg_table() to install one of them as profile 0 and pick it by
++i2c address (0x34 speaker, 0x36 receiver, matching AW882XX_SPEAKER_NAME and
++AW882XX_RECEIVER_NAME), falling back to an absolute /vendor/firmware path when
++the plain name does not resolve.
++
++This restores the board specific values instead of the generic defaults - most
++visibly I2SCTRL 0x06 with the left channel bit (0x18e8 against the driver's
++0x14e8, the channel aw_device_parse_dt() defaults to when the device tree has no
++sound-channel property, which is the case here).
++
++Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
++---
++ .../audio/asoc/codecs/awinic/inc/aw_device.h  |  1 +
++ .../audio/asoc/codecs/awinic/src/aw_device.c  | 40 +++++++++++++++++++
++ 2 files changed, 41 insertions(+)
++
++diff --git a/techpack/audio/asoc/codecs/awinic/inc/aw_device.h b/techpack/audio/asoc/codecs/awinic/inc/aw_device.h
++index 5cffa24dc..8f278c598 100755
++--- a/techpack/audio/asoc/codecs/awinic/inc/aw_device.h
+++++ b/techpack/audio/asoc/codecs/awinic/inc/aw_device.h
++@@ -192,6 +192,7 @@ int aw_device_init(struct aw_device *aw_dev, struct aw_container *aw_cfg);
++ int aw_device_start(struct aw_device *aw_dev);
++ int aw_device_stop(struct aw_device *aw_dev);
++ int aw_dev_fw_update(struct aw_device *aw_dev,  bool prof_sw);
+++int aw_dev_load_reg_table(struct aw_device *aw_dev, uint8_t *data, uint32_t len);
++ 
++ //profile
++ int aw_dev_prof_update(struct aw_device *aw_dev);
++diff --git a/techpack/audio/asoc/codecs/awinic/src/aw_device.c b/techpack/audio/asoc/codecs/awinic/src/aw_device.c
++index 64d639a51..ba4615a4d 100755
++--- a/techpack/audio/asoc/codecs/awinic/src/aw_device.c
+++++ b/techpack/audio/asoc/codecs/awinic/src/aw_device.c
++@@ -165,6 +165,46 @@ static int aw_dev_parse_raw_reg(struct aw_device *aw_dev,
++ 	return 0;
++ }
++ 
+++/*
+++ * EEBBK S6 (P20H130): this ROM ships no acf file, only the older AWINIC raw
+++ * register tables (aw882xx_spk_reg_l.bin and friends in /vendor/firmware).  A
+++ * bare list of 16 bit register addresses and values is exactly the format
+++ * aw_dev_parse_raw_reg() stores and aw_dev_reg_fw_update() programs into the
+++ * chip, so such a table can be installed as profile 0 ("Music") and applied by
+++ * the normal start path.  That restores the vendor settings - among them
+++ * I2SCTRL 0x06 with the channel bit (0x18e8 for the left part against the
+++ * generic 0x14e8 the driver would otherwise use) - which is what the
+++ * amplifiers need to produce sound on this board.
+++ */
+++int aw_dev_load_reg_table(struct aw_device *aw_dev, uint8_t *data, uint32_t len)
+++{
+++	struct aw_prof_desc *prof_desc;
+++
+++	if (aw_dev == NULL || data == NULL || len < 4)
+++		return -EINVAL;
+++
+++	if (aw_dev->prof_info.prof_desc == NULL) {
+++		aw_dev->prof_info.prof_desc =
+++			kzalloc(sizeof(struct aw_prof_desc) * AW_PROFILE_MAX,
+++				GFP_KERNEL);
+++		if (aw_dev->prof_info.prof_desc == NULL)
+++			return -ENOMEM;
+++	}
+++
+++	prof_desc = &aw_dev->prof_info.prof_desc[0];
+++	memset(prof_desc, 0, sizeof(*prof_desc));
+++
+++	if (aw_dev_parse_raw_reg(aw_dev, data, len, prof_desc))
+++		return -EINVAL;
+++
+++	prof_desc->id = 0;			/* "Music" */
+++	aw_dev->prof_info.count = 1;
+++	aw_dev->set_prof = 0;
+++	aw_dev->cur_prof = -1;			/* force a register update */
+++
+++	return 0;
+++}
+++
++ static int aw_dev_parse_raw_dsp(struct aw_device *aw_dev,
++ 			uint8_t *data, uint32_t data_len, struct aw_prof_desc *prof_desc)
++ {
+diff --git a/patch_final/per-commit/0048-input-misc-mxm1120-Set-START-when-enabling-the-hall-.patch b/patch_final/per-commit/0048-input-misc-mxm1120-Set-START-when-enabling-the-hall-.patch
+new file mode 100644
+index 000000000..cfd479c09
+--- /dev/null
++++ b/patch_final/per-commit/0048-input-misc-mxm1120-Set-START-when-enabling-the-hall-.patch
+@@ -0,0 +1,77 @@
++From bdb2804e9458e3c433b0d66102a44e540dbb41e4 Mon Sep 17 00:00:00 2001
++From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
++Date: Fri, 18 Sep 2026 18:01:43 +0800
++Subject: [PATCH 48/67] input: misc: mxm1120: Set START when enabling the hall
++ sensor
++
++The factory's m1120_set_operation_mode() writes OPMODE | 0x09 to begin
++converting and OPMODE & ~0x01 to stop, so bit 0 is START.  This driver toggled
++bit 6 instead, which left the part in standby: register 0x10 read zero, the
++status byte never reported DRDY and bbk_hall_data reported -2000 for both
++sensors.  With START set the samples come alive - up:1 down:-700 on this
++device.
++
++Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
++---
++ drivers/input/misc/mxm1120.c | 32 ++++++++++++++++++++++++++------
++ 1 file changed, 26 insertions(+), 6 deletions(-)
++
++diff --git a/drivers/input/misc/mxm1120.c b/drivers/input/misc/mxm1120.c
++index ecc534685..7a5c43bb3 100644
++--- a/drivers/input/misc/mxm1120.c
+++++ b/drivers/input/misc/mxm1120.c
++@@ -17,12 +17,14 @@
++  *   read : i2c_smbus_read_i2c_block_data(client, reg, len, buf)
++  *
++  * Register map
++- *   0x00  device id / status   read 1 byte, expected 0x9c on a healthy part;
++- *                              bits 7:6 are the two high bits of the field in
++- *                              10-bit mode
+++ *   0x00  command              written 0x40 at probe
++  *   0x01  control              written 0x00, then (value & 0x7f)
++  *   0x07  control              written 0x01
++- *   0x08  operation mode       written 0x40 (measurement), (value & 0xfe)
+++ *   0x08  operation mode       written 0x40 at probe; bit 0 is START and is set
+++ *                              with bit 3 to convert, cleared to stop
+++ *   0x09  chip id              read 1 byte, expected 0x9c
+++ *   0x10  sample               3 bytes: status (bit 0 = DRDY, required), low
+++ *                              byte, and the high bits plus sign
++  *   0x10  3-byte measurement   buf[0] = status (bit 0 = DRDY), buf[1] = low
++  *                              bits, buf[2] = high bits
++  *   0x00..0x0a                 dumped by the vendor's debug path
++@@ -101,6 +103,14 @@ extern void bbk_hall_core_unregister_device(struct hall_dev *dev);
++ #define M1120_DATA_LEN		3
++ #define M1120_DUMP_LEN		0x14
++ #define M1120_OP_MEASUREMENT	0x40
+++/*
+++ * [RE] Bit 0 of the operation mode register is START: the factory's
+++ * m1120_set_operation_mode() writes (mode | 0x09) to begin converting and
+++ * (mode & ~0x01) to stop.  Bit 3 is set together with it.  Bit 6 is a mode
+++ * selector that is already set by the probe.
+++ */
+++#define M1120_OP_START		0x01
+++#define M1120_OP_START_SET	0x09
++ 
++ enum m1120_pos {
++ 	M1120_POS_UP = 0,
++@@ -221,8 +231,18 @@ static int m1120_set_operation_mode(struct m1120_data *d, bool measure)
++ 	ret = m1120_read_block(d, M1120_REG_OPMODE, 1, &v);
++ 	if (ret)
++ 		return ret;
++-	v = measure ? (v | M1120_OP_MEASUREMENT) : (v & ~M1120_OP_MEASUREMENT);
++-	return m1120_i2c_set_reg(d, M1120_REG_OPMODE, v);
+++
+++	/*
+++	 * [RE] Start and stop the conversion through START (bit 0), the way the
+++	 * factory does.  Toggling bit 6 instead - as this driver did - leaves
+++	 * the chip in standby: register 0x10 stays zero, the status byte never
+++	 * reports DRDY and every sample decodes to nothing.
+++	 */
+++	v = measure ? (v | M1120_OP_START_SET) : (v & ~M1120_OP_START);
+++	ret = m1120_i2c_set_reg(d, M1120_REG_OPMODE, v);
+++	dev_info(d->dev, "%s: %s, opmode 0x%02x\n", __func__,
+++		 measure ? "start conversion" : "stop conversion", v);
+++	return ret;
++ }
++ 
++ /*
