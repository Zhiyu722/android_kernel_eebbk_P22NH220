+++++}
+++++
+++++static ssize_t vib_pwm_up_down_count_store(struct device *dev, struct device_attribute *attr,
+++++					   const char *buf, size_t count)
+++++{
+++++	struct vib_pwm *d = dev_get_drvdata(dev);
