+-+++  `if (p[+4] != 1) { printk("zyhc set mhall cali data failed"); return -1; }`
+-+++  `mhall_fake_data_up = *(s16*)(p+0); mhall_fake_data_down = *(s16*)(p+2);`
+-+++  `mhall_fake_data3 = *(s16*)(p+8); mhall_fake_data2 = *(int*)(p+40); mhall_fake_data_add_time = *(int*)(p+44);`
