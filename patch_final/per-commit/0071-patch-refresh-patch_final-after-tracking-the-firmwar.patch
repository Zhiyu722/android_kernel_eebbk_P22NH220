++++#### (12) `vib_pwm_elevator_row_shift` 0664，**只读**
++++```c
++++s16 up = 0, down = 0;
++++s16 c8  = *(s16*)(g_mhall_cali_data + 8);    /* 0x9f75648 */
++++s16 c16 = *(s16*)(g_mhall_cali_data + 16);
++++s16 c24 = *(s16*)(g_mhall_cali_data + 24);
++++s16 c32 = *(s16*)(g_mhall_cali_data + 32);
