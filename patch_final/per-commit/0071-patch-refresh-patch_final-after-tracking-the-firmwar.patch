++-++/* store */
++-++int val = 0;
++-++if (!buf || !count) return count;
++-++if (kstrtoint(buf, 10, &val)) h->count = 0;   /* 编译产物：先写 0 再写 val */
++-++h->count = val;
++-++return count;
