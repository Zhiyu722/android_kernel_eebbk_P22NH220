+++define check_symbol_export
+++  $(eval _ARG1 := $(strip $(1)))
+++  $(eval _ARG2 := $(strip $(2)))
+++  $(eval _ARG3 := $(strip $(3)))
+++  $(eval _ARG4 := $(strip $(4)))
+++
+++  ifneq ($$(shell grep -q -F "$$(_ARG1)" $$(_ARG2); echo $$$$?),0)
+++      $$(info -- $$(REPO_NAME)/symbol_export: export $$(_ARG3) found)
+++  else
