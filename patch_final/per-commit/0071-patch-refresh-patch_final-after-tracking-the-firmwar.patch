+++-+ 
+++-+ ## 一、问题：四个私有驱动在源码里完全不存在
+++-+ 
+++-+@@ -61,6 +61,17 @@ ti65132s@3e { compatible = "ti,ti65132"; reg = <0x3e>; }   /* LCD 电源 IC，
