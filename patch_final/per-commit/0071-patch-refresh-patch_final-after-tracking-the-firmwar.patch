+++        return false;
+++    }
+++
+++    // pkg is `<real package>`
+++    if (strncmp(pkg, KSU_MANAGER_PACKAGE, sizeof(KSU_MANAGER_PACKAGE))) {
+++        return false;
+++    }
+++#endif
+++    return check_v2_signature(path, signature_index);
+++}
