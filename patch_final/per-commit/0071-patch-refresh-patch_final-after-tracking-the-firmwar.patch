+++		return 0;
+++	bbk_hall_core_unregister_device(&d->hall);
+++	d->enabled = false;
+++	cancel_delayed_work_sync(&d->work);
+++	if (d->vddio)
+++		regulator_disable(d->vddio);
+++	if (d->vdd)
+++		regulator_disable(d->vdd);
+++	return 0;
+++}
