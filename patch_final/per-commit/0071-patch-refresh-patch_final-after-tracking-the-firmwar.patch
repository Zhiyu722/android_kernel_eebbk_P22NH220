+new file mode 100644
+index 000000000..4ec137221
+--- /dev/null
++++ b/patch_final/per-commit/0044-ASoC-msm-dai-q6-Accept-32-bit-samples-on-the-MI2S-ba.patch
+@@ -0,0 +1,52 @@
++From 9d2889df65167a31a39a714c3f54e1a45bc1fe5e Mon Sep 17 00:00:00 2001
++From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
++Date: Fri, 18 Sep 2026 18:01:42 +0800
++Subject: [PATCH 44/67] ASoC: msm-dai-q6: Accept 32 bit samples on the MI2S
++ backend
++
++The ROM's audio HAL drives the speaker through the tertiary MI2S port with 32
++bit samples: it writes 32 to the backend's BitWidth mixer control and opens the
++PCM with SNDRV_PCM_FORMAT_S32_LE, which is format 10 in the kernel log.  The
++version of msm_dai_q6_mi2s_hw_params() in this tree only handles S16_LE,
++SPECIAL, S24_LE and S24_3LE, so every playback failed with
++
++    msm_dai_q6_mi2s_hw_params: format 10
++    ASoC: can't set Tertiary MI2S hw params: -22
++     TERT_MI2S_RX: ASoC: hw_params BE failed -22
++     SM6150 LowLatency: ASoC: hw_params BE failed -22
++
++and the speaker stayed silent even though the card, the route and the ACDB
++calibration were all applied.  The vendor's own build of this driver - pulled
++from the device as audio_platform.ko - writes bit_width = 32, so the 32 bit case
++is restored here to match it.
++
++Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
++---
++ techpack/audio/asoc/msm-dai-q6-v2.c | 14 ++++++++++++++
++ 1 file changed, 14 insertions(+)
++
++diff --git a/techpack/audio/asoc/msm-dai-q6-v2.c b/techpack/audio/asoc/msm-dai-q6-v2.c
++index 76dba8f22..0454958ba 100755
++--- a/techpack/audio/asoc/msm-dai-q6-v2.c
+++++ b/techpack/audio/asoc/msm-dai-q6-v2.c
++@@ -5239,6 +5239,20 @@ static int msm_dai_q6_mi2s_hw_params(struct snd_pcm_substream *substream,
++ 		dai_data->port_config.i2s.bit_width = 24;
++ 		dai_data->bitwidth = 24;
++ 		break;
+++	/*
+++	 * EEBBK S6 (P20H130): the ROM's audio HAL drives the speaker path -
+++	 * Tertiary MI2S into the two AW882xx amplifiers - with 32 bit samples
+++	 * (it writes 32 to the BitWidth mixer control and opens the PCM with
+++	 * SNDRV_PCM_FORMAT_S32_LE, which is format 10 in the kernel log).
+++	 * Without this case every playback of that route fails with
+++	 * "can't set Tertiary MI2S hw params: -22" and the speaker stays
+++	 * silent.  The vendor's own build of this driver accepts it and
+++	 * programs bit_width = 32, which is what the AFE interface allows.
+++	 */
+++	case SNDRV_PCM_FORMAT_S32_LE:
+++		dai_data->port_config.i2s.bit_width = 32;
+++		dai_data->bitwidth = 32;
+++		break;
++ 	default:
++ 		pr_err("%s: format %d\n",
++ 			__func__, params_format(params));
+diff --git a/patch_final/per-commit/0045-ASoC-sm6150-Drive-the-tertiary-MI2S-link-with-the-AW.patch b/patch_final/per-commit/0045-ASoC-sm6150-Drive-the-tertiary-MI2S-link-with-the-AW.patch
+new file mode 100644
+index 000000000..efc097ff0
+--- /dev/null
++++ b/patch_final/per-commit/0045-ASoC-sm6150-Drive-the-tertiary-MI2S-link-with-the-AW.patch
+@@ -0,0 +1,51 @@
++From d799367d8798995fd058597b8ae44cfc2997e1df Mon Sep 17 00:00:00 2001
++From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
++Date: Fri, 18 Sep 2026 18:01:42 +0800
++Subject: [PATCH 45/67] ASoC: sm6150: Drive the tertiary MI2S link with the
++ AW882xx codec
++
++The ROM's mixer paths send speaker playback to the tertiary MI2S backend
++("TERT_MI2S_RX Audio Mixer MultiMedia5") and its HAL registers the speaker
++device on it, but this table named msm-stub-codec.1 there.  A stub has no DAI
++events, so the AWINIC AW882xx amplifiers on that port were never started: their
++SYSCTRL register (0x04) stayed at 0x4003 - PWDN and AMPPD set - through every
++playback.  Point the link at the same awinic_codecs components the primary MI2S
++link already uses (the device tree gives both amplifiers on i2c 2-0034 and
++2-0036), after which the driver's startup, hw_params, mute and power up sequence
++all run and the chip leaves power down while audio plays.
++
++Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
++---
++ techpack/audio/asoc/sm6150.c | 17 +++++++++++++++++
++ 1 file changed, 17 insertions(+)
++
++diff --git a/techpack/audio/asoc/sm6150.c b/techpack/audio/asoc/sm6150.c
++index bef9465a0..dcdbe7734 100755
++--- a/techpack/audio/asoc/sm6150.c
+++++ b/techpack/audio/asoc/sm6150.c
++@@ -7784,8 +7784,25 @@ static struct snd_soc_dai_link msm_mi2s_be_dai_links[] = {
++ 		.stream_name = "Tertiary MI2S Playback",
++ 		.cpu_dai_name = "msm-dai-q6-mi2s.2",
++ 		.platform_name = "msm-pcm-routing",
+++#ifdef CONFIG_SND_SOC_AWINIC_AW882XX
+++		/*
+++		 * EEBBK S6 (P20H130): the speaker is driven by the two AWINIC
+++		 * AW882xx amplifiers on the tertiary MI2S port.  The ROM's
+++		 * mixer paths route speaker playback with
+++		 * "TERT_MI2S_RX Audio Mixer MultiMedia5" and its HAL registers
+++		 * the speaker device on this backend, but this table used to
+++		 * name msm-stub-codec.1 here.  A stub has no DAI events, so
+++		 * the amplifiers were never taken out of power down: reading
+++		 * the chip showed SYSCTRL (0x04) stuck at 0x4003 - PWDN and
+++		 * AMPPD set - through every playback, and the speaker stayed
+++		 * silent even after the PCM started without error.
+++		 */
+++		.num_codecs = ARRAY_SIZE(awinic_codecs),
+++		.codecs = awinic_codecs,
