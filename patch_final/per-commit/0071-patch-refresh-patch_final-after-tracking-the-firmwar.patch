++++  case 2:   /* 收敛到 100% */
++++    if (mhall_fake_data5 != 0) {           /* 默认 0，不走这条 */
++++        tgt = |(s16)g_hall_cali_data[36]|; v = |up|;
++++        printk("zyha2 distance(up):%d,target_distance:%d\n", v, tgt);
++++        dd = tgt - v; if (dd <= 0) return 0;
++++        time = mhall_fake_data5 * dd / 1000;
