+++
+++    src = symtab_search(&db->p_types, s);
+++    if (src == NULL) {
+++        pr_info("source type %s does not exist\n", s);
+++        return false;
+++    }
+++    tgt = symtab_search(&db->p_types, t);
+++    if (tgt == NULL) {
+++        pr_info("target type %s does not exist\n", t);
+++        return false;
