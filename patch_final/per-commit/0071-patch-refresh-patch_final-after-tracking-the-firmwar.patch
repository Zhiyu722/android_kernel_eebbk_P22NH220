+-+++if      (!strncmp(buf, "0", 1)) { h->holder_mode = 0; }
+-+++else if (!strncmp(buf, "1", 1)) { h->holder_mode = 1; }
+-+++else if (!strncmp(buf, "2", 1)) { h->holder_mode = 2; vib_pwm_set_camera(0); }
+-+++else if (!strncmp(buf, "3", 1)) { h->holder_mode = 3; vib_pwm_set_camera(0); }
