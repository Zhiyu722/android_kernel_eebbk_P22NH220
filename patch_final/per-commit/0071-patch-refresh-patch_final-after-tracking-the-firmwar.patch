+++++
+++++	if (kstrtoint(buf, 10, &v) == 0)
+++++		d->elevator_mode = v;
+++++	return count;
+++++}
+++++
+++++static ssize_t vib_pwm_elevator_row_shift_show(struct device *dev, struct device_attribute *attr,
+++++					       char *buf)
+++++{
+++++	struct vib_pwm *d = dev_get_drvdata(dev);
+++++
+++++	return sprintf(buf, "%d\n", d->elevator_row_shift);
+++++}
