++++    struct { s16 up; s16 down; s32 diff; } p24;   /* +12, +14, +16 */
++++    struct { s16 up; s16 down; s32 diff; } p48;   /* +20, +22, +24 */
++++    struct { s16 up; s16 down; s32 diff; } p696;  /* +28, +30, +32 */
++++    struct { s16 up; s16 down; s32 diff; } p1;    /* +36, +38, +40 */
