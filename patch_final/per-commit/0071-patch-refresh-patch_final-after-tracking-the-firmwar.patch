+++    rcu_read_lock();
+++    hash_for_each_rcu (allow_list, iter, p, list) {
+++        // pr_info("get_allow_list uid: %d allow: %d\n", p->uid, p->allow);
+++        if (p->profile.allow_su == allow && !ksu_is_manager_uid(p->profile.curr_uid)) {
