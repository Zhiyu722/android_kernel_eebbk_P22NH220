+++        print('\n%d edit(s) failed - nothing written' % len(bad))
+++        return 1
+++    for path, s in touched.items():
+++        write(os.path.join(tree, path), s)
+++    print('\nwrote %d file(s): %s' % (len(touched), ', '.join(sorted(touched))))
+++    return 0
