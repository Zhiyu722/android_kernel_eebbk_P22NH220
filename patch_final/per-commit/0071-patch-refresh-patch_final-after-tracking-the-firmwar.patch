+--++{
+--++	if (up)
+--++		*up = -2000;
+--++	if (down)
+--++		*down = -2000;
+--++	return -1;
+--++}
+--++
+--+ int __weak bbk_hall_get_status(void)
+--+ {
+--+ 	return 0;
+--+ }
+--+ 
+--++void __weak bbk_hall_core_init_queue(void)
+--++{
+--++}
+--++
+--++void __weak bbk_hall_core_init_move_queue(void)
+--++{
+--++}
