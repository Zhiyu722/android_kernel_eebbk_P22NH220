++++        t = pos - 11101; time = all_time*t/15950;
++++        printk("damon get 1-down all time …\n");
++++        target=1; camera_state=5; enable=2; key=635; goto start;
++++    }
++++    t = 11101 - pos; if (t < 1001) return 0;
++++    time = all_time*t/15950;
