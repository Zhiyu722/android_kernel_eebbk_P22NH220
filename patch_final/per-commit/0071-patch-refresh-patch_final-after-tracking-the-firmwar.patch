++++ 	. = ALIGN(PAGE_SIZE);
++++ 	idmap_pg_dir = .;
++++ 	. += IDMAP_DIR_SIZE;
++++@@ -253,10 +268,6 @@
++++ 	STABS_DEBUG
++++ 
++++ 	HEAD_SYMBOLS
++++-
++++-	.bss : {			/* bss segment		*/
++++-         RTIC_BSS
++++-	}
++++ }
++++ 
