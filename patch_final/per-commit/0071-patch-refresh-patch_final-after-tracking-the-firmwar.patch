+++#else
+++    struct file *ns_file = dentry_open(ns_path.dentry, ns_path.mnt, O_RDONLY, ksu_cred);
+++#endif
+++
+++    path_put(&ns_path);
+++    if (IS_ERR(ns_file)) {
+++        pr_warn("failed open file for init mount namespace: %ld\n", PTR_ERR(ns_file));
+++        goto out;
+++    }
+++
+++    int fd = get_unused_fd_flags(O_CLOEXEC);
+++    if (fd < 0) {
