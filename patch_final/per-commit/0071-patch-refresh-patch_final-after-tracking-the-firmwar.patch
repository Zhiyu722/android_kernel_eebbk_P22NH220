+++    int cmd = (int)PT_REGS_PARM3(real_regs);
+++    void __user **arg = (void __user **)&PT_REGS_SYSCALL_PARM4(real_regs);
+++
+++    ksu_handle_sys_reboot(magic1, magic2, cmd, arg);
+++    return 0;
+++}
