++++{
++++	struct mhall_data *d = mhall_data;
++++	s16 up = -2000, down = -2000;
++++	int i;
++++
++++	if (d) {
++++		for (i = 0; i < 10; i++) {
++++			s16 u = -2000, dn = -2000;
++++
++++			if (hall_read_one(d->hall_up, &u) == 0 &&
++++			    hall_read_one(d->hall_down, &dn) == 0) {
++++				up = u;
++++				down = dn;
++++				break;
++++			}
++++			msleep(2);
++++		}
++++	}
++++	return sprintf(buf, "up:%d down:%d\n", up, down);
