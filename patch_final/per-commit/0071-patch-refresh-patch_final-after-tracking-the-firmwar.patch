++diff --git a/drivers/misc/bbk_debug.c b/drivers/misc/bbk_debug.c
++new file mode 100755
++index 000000000..8be9d402d
++--- /dev/null
+++++ b/drivers/misc/bbk_debug.c
++@@ -0,0 +1,268 @@
+++/*
+++ * Bring-up aid for the EEBBK S6 (P20H130).
+++ *
+++ * On this ROM the kernel log is not readable from adb shell: /dev/kmsg is root
+++ * only, the syslog syscall is restricted and logd's kernel buffer is disabled,
+++ * so a driver that fails to probe leaves no trace we can see.  These nodes
+++ * publish the ring buffer and the state of the elevator pins to any reader,
+++ * which is what
+++ *
+++ *     adb shell "echo clear > /proc/eebbk_kmsg"      # drop the audit spam
+++ *     adb shell "echo vib_pwm > /proc/eebbk_kmsg"    # keep only these lines
+++ *     adb shell cat /proc/eebbk_kmsg
+++ *
+++ * needs during bring-up.  Everything is compiled in only when
+++ * CONFIG_BBK_DEBUG_BRINGUP is set, together with the SELinux permissive
+++ * override in security/selinux/hooks.c, so the normal image is unaffected.
+++ *
+++ * The log node is world writable on purpose: adb shell is not root here, and
+++ * a 0600 node would be useless.  It exists in bring-up images only.
+++ *
+++ * SPDX-License-Identifier: GPL-2.0
+++ */
+++#include <linux/module.h>
+++#include <linux/init.h>
+++#include <linux/kernel.h>
+++#include <linux/proc_fs.h>
+++#include <linux/fs.h>
+++#include <linux/uaccess.h>
+++#include <linux/syslog.h>
+++#include <linux/slab.h>
+++#include <linux/seq_file.h>
+++#include <linux/gpio.h>
+++#include <linux/gpio/consumer.h>
+++#include <linux/clk.h>
+++#include <linux/clk-provider.h>
+++
+++#ifndef SYSLOG_ACTION_READ_ALL
+++#define SYSLOG_ACTION_READ_ALL	3
+++#endif
+++#ifndef SYSLOG_ACTION_READ_CLEAR
+++#define SYSLOG_ACTION_READ_CLEAR	4
+++#endif
+++
+++/*
+++ * do_syslog()'s fourth argument.  check_syslog_permissions() lets a caller that
+++ * claims to come from /proc through without CAP_SYSLOG:
+++ *
+++ *	if (source == SYSLOG_FROM_PROC && type != SYSLOG_ACTION_OPEN)
+++ *		goto ok;
+++ *
+++ * which is exactly what this node needs; what remains is security_syslog(),
+++ * and the bring-up build runs SELinux permissive.
+++ */
+++#ifndef SYSLOG_FROM_PROC
+++#define SYSLOG_FROM_PROC	1
+++#endif
+++
+++#define BBK_KMSG_NAME		"eebbk_kmsg"
+++#define BBK_PINS_NAME		"eebbk_pins"
+++
+++#define BBK_KMSG_MAX		(1024 * 1024)
+++#define BBK_KMSG_PATTERN_MAX	32
+++
+++static char *bbk_kmsg_buf;
+++static char bbk_kmsg_pattern[BBK_KMSG_PATTERN_MAX];
+++static DEFINE_MUTEX(bbk_kmsg_lock);
+++
+++/* reading the whole ring buffer through copy_to_user needs a kernel pointer */
+++static int bbk_kmsg_snapshot(char *dst, size_t size)
+++{
+++	mm_segment_t oldfs;
+++	int len;
+++
+++	oldfs = get_fs();
+++	set_fs(KERNEL_DS);
+++	len = do_syslog(SYSLOG_ACTION_READ_ALL, dst, size, SYSLOG_FROM_PROC);
+++	set_fs(oldfs);
+++	return len;
+++}
+++
+++static void bbk_kmsg_drop(void)
+++{
+++	mm_segment_t oldfs;
+++	char junk[256];
+++
+++	oldfs = get_fs();
+++	set_fs(KERNEL_DS);
+++	do_syslog(SYSLOG_ACTION_READ_CLEAR, junk, sizeof(junk), SYSLOG_FROM_PROC);
+++	set_fs(oldfs);
+++}
+++
+++/*
+++ * Writing a pattern selects which lines the next read returns; "clear" empties
+++ * the ring buffer so that the next read only shows what happened after it.
+++ */
+++static ssize_t bbk_kmsg_write(struct file *file, const char __user *ubuf,
+++			      size_t count, loff_t *ppos)
+++{
+++	char tmp[BBK_KMSG_PATTERN_MAX];
+++	size_t n = count;
+++
+++	if (!n)
+++		return 0;
+++	if (n > sizeof(tmp) - 1)
+++		n = sizeof(tmp) - 1;
+++	if (copy_from_user(tmp, ubuf, n))
+++		return -EFAULT;
+++	tmp[n] = 0;
+++	while (n && (tmp[n - 1] == '\n' || tmp[n - 1] == '\r'))
+++		tmp[--n] = 0;
+++
+++	mutex_lock(&bbk_kmsg_lock);
+++	if (!strcmp(tmp, "clear")) {
+++		bbk_kmsg_drop();
+++		bbk_kmsg_pattern[0] = 0;
+++	} else {
+++		memcpy(bbk_kmsg_pattern, tmp, n + 1);
+++	}
+++	mutex_unlock(&bbk_kmsg_lock);
+++	return count;
+++}
+++
+++static ssize_t bbk_kmsg_read(struct file *file, char __user *ubuf,
+++			     size_t count, loff_t *ppos)
+++{
+++	char line[1024];
+++	char pat[BBK_KMSG_PATTERN_MAX];
+++	char *r, *w, *end;
+++	int len, total, ret = 0;
+++
+++	/*
+++	 * READ_ALL always hands back the whole ring buffer, so without this a
+++	 * reader like cat would loop for ever.  One snapshot per open is what a
+++	 * bring-up node needs.
+++	 */
+++	if (!count || *ppos)
+++		return 0;
+++
+++	mutex_lock(&bbk_kmsg_lock);
+++	if (!bbk_kmsg_buf) {
+++		/* 1 MB is too big for kmalloc on this device, so use vmalloc */
+++		bbk_kmsg_buf = vzalloc(BBK_KMSG_MAX);
+++		if (!bbk_kmsg_buf) {
+++			mutex_unlock(&bbk_kmsg_lock);
+++			return -ENOMEM;
+++		}
+++	}
+++	memcpy(pat, bbk_kmsg_pattern, sizeof(pat));
+++
+++	len = bbk_kmsg_snapshot(bbk_kmsg_buf, BBK_KMSG_MAX - 1);
+++	if (len < 0) {
+++		mutex_unlock(&bbk_kmsg_lock);
+++		return len;
+++	}
+++	bbk_kmsg_buf[len] = 0;
+++
+++	/* filter in place: the write cursor never passes the read cursor */
+++	r = bbk_kmsg_buf;
+++	w = bbk_kmsg_buf;
+++	end = bbk_kmsg_buf + len;
+++	while (r < end) {
+++		char *nl = memchr(r, '\n', end - r);
+++		size_t whole = nl ? (size_t)(nl - r) + 1 : (size_t)(end - r);
+++		size_t l = whole;
+++
+++		if (l > sizeof(line) - 1)
+++			l = sizeof(line) - 1;
+++		memcpy(line, r, l);
+++		line[l] = 0;
+++		if (!pat[0] || strstr(line, pat)) {
+++			memmove(w, r, whole);
+++			w += whole;
+++		}
+++		r += whole;
+++	}
+++
+++	total = w - bbk_kmsg_buf;
+++	if (total > (int)count) {
+++		/* hand back the newest lines that fit in the reader's buffer */
+++		int skip = total - (int)count;
+++
+++		memmove(bbk_kmsg_buf, bbk_kmsg_buf + skip, count);
+++		total = count;
+++	}
+++	if (total && copy_to_user(ubuf, bbk_kmsg_buf, total))
+++		ret = -EFAULT;
+++	else
+++		ret = total;
+++
+++	mutex_unlock(&bbk_kmsg_lock);
+++	if (ret > 0)
+++		*ppos += ret;
+++	return ret;
+++}
+++
+++static const struct file_operations bbk_kmsg_fops = {
+++	.owner	= THIS_MODULE,
+++	.read	= bbk_kmsg_read,
+++	.write	= bbk_kmsg_write,
+++	.llseek	= no_llseek,
+++};
+++
+++/*
+++ * /proc/eebbk_pins - the electrical state of the elevator, which is otherwise
+++ * invisible: debugfs is not mounted and adb shell is not root.  The pins and
+++ * their polarity are the ones the device tree gives soc:bbk_vib_pwm; gpio21 is
+++ * the pin that carries the gcc_gp2 clock when the "vib_pwm_active" pinctrl
+++ * state is selected, which is how the motor gets its drive waveform.
+++ */
+++static int bbk_pins_show(struct seq_file *m, void *v)
+++{
+++	static const int pins[] = { 21, 23, 24, 25, 26, 29 };
+++	struct clk *c;
+++	int i;
+++
+++	for (i = 0; i < ARRAY_SIZE(pins); i++) {
+++		struct gpio_desc *dsc = gpio_to_desc(pins[i]);
+++
+++		if (!dsc) {
+++			seq_printf(m, "gpio%-3d not a gpio here\n", pins[i]);
+++			continue;
+++		}
+++		seq_printf(m, "gpio%-3d raw=%d %s\n", pins[i],
+++			   gpiod_get_raw_value_cansleep(dsc),
+++			   gpiod_get_direction(dsc) ? "in" : "out");
+++	}
+++	seq_puts(m, "dir=26 (0 up, 1 down) enable=23 (0 on) boost=24 (1 on) "
+++		    "sleep=29 (1 on) id=25\n");
+++
+++	c = clk_get(NULL, "gcc_gp2_clk");
+++	if (IS_ERR(c)) {
+++		seq_printf(m, "gcc_gp2_clk not found (%ld)\n", PTR_ERR(c));
+++	} else {
+++		seq_printf(m, "gcc_gp2_clk rate=%lu enabled=%d\n",
+++			   clk_get_rate(c), __clk_is_enabled(c));
+++		clk_put(c);
+++	}
+++	return 0;
+++}
+++
+++static int bbk_pins_open(struct inode *inode, struct file *file)
+++{
+++	return single_open(file, bbk_pins_show, NULL);
+++}
+++
+++static const struct file_operations bbk_pins_fops = {
+++	.owner		= THIS_MODULE,
+++	.open		= bbk_pins_open,
+++	.read		= seq_read,
+++	.llseek		= seq_lseek,
+++	.release	= single_release,
+++};
+++
+++static int __init bbk_debug_init(void)
+++{
+++	if (!proc_create(BBK_KMSG_NAME, 0666, NULL, &bbk_kmsg_fops))
+++		pr_err("bbk_debug: cannot create /proc/%s\n", BBK_KMSG_NAME);
+++	if (!proc_create(BBK_PINS_NAME, 0444, NULL, &bbk_pins_fops))
+++		pr_err("bbk_debug: cannot create /proc/%s\n", BBK_PINS_NAME);
+++	pr_info("bbk_debug: /proc/%s and /proc/%s ready (bring-up build)\n",
+++		BBK_KMSG_NAME, BBK_PINS_NAME);
+++	return 0;
+++}
+++late_initcall(bbk_debug_init);
+++
+++MODULE_AUTHOR("EEBBK S6 kernel reconstruction");
+++MODULE_DESCRIPTION("Bring-up kernel log and elevator pin nodes for the EEBBK S6");
+++MODULE_LICENSE("GPL v2");
++diff --git a/drivers/misc/gpio_pwm.c b/drivers/misc/gpio_pwm.c
++new file mode 100755
++index 000000000..a22b1f8b8
++--- /dev/null
+++++ b/drivers/misc/gpio_pwm.c
++@@ -0,0 +1,1549 @@
+++/*
+++ * BBK elevator camera motor controller for the EEBBK S6 (P20H130).
+++ *
+++ * The front camera of this device sits on a motorised elevator: it is pushed
+++ * out of the body when the camera application starts and retracted again
+++ * afterwards.  The controller driver is called vib_pwm in the factory kernel
+++ * (its source file is drivers/input/hall/vib_pwm/gpio_pwm.c and its module
+++ * name is gpio_pwm) and it is built in, so its sources are not part of this
+++ * tree.  The device tree binding, the sysfs interface, the state machine and
+++ * the motor timing below were recovered from the factory boot image, whose
+++ * kallsyms still carries every symbol name, and from the factory device tree.
+++ *
+++ * Hardware, from the node soc:bbk_vib_pwm (compatible "bbk,vib_pwm_control")
+++ *   boost-gpio  gpio24  driver supply boost, one while moving, zero idle
+++ *   enable-gpio gpio23  driver enable, active low: zero while moving
+++ *   sleep-gpio  gpio29  driver nSLEEP, one while moving, zero idle
+++ *   dir-gpio    gpio26  zero moves the elevator up, one moves it down
+++ *   id-gpio     gpio25  elevator module id strap, read through a pull-up
+++ *   clocks = <&gcc GCC_GP2_CLK>, clock-names = "gp2_clk"
+++ *
+++ * There is no pwm controller in the binding: the drive waveform is the general
+++ * purpose clock gcc_gp2_clk, which the "vib_pwm_active" pinctrl state routes
+++ * out on gpio21, so the chopper frequency is simply the clock rate handed to
+++ * clk_set_rate.  GCC_GP2_CLK is clock id 36 in qcom,gcc-sdmmagpie.h and
+++ * gcc_gp2_clk_src is a fractional (mnd) rcg, so the 19200, 32000, 41600 and
+++ * 4800 Hz the vendor uses are all synthesizable even though the preset table
+++ * only lists 19.2, 25, 50, 100 and 200 MHz.
+++ *
+++ * Camera positions.  The vendor measures the travel on a scale that runs from
+++ * 0 (retracted) to 15950 (fully extended), with anchors at 3828 (24%),
+++ * 7656 (48%) and 11101 (69.6%), and it exposes these values through
+++ * vib_pwm_camera_state:
+++ *   0  retracted                 4  moving up        (busy)
+++ *   1  69.6%, the camera mid row 5  moving down      (busy)
+++ *   2  fully extended            6  stopped by the anti-pinch logic
+++ *   7  holder position, between 1 and 2
+++ *
+++ * The vendor driver's private data is 680 bytes and every handler addresses it
+++ * by offset, so the offsets are recorded here for traceability:
+++ *   +0x10 boost gpio  +0x14 enable gpio  +0x18 sleep gpio  +0x1C dir gpio
+++ *   +0x20 id gpio     +0x28 pinctrl      +0x30/38/40 pins active/suspend/id
+++ *   +0x48 struct clk *gp2_clk            +0x50 struct wakeup_source
+++ *   +0x118 struct hrtimer                +0x158 ktime_t of the current move
+++ *   +0x160 int time   +0x164 int pre_time +0x168 u8 is_subsection
+++ *   +0x190 u64 freq   +0x198 int count    +0x19C int enable (1 up, 2 down)
+++ *   +0x1A0 int camera_state               +0x1A4 int target_state
+++ *   +0x1A8 int key_idle                   +0x1AC u8 pending_notify
+++ *   +0x1B0 int holder_mode                +0x1B4 int elevator_mode
+++ *   +0x1B8 char notify_str[32]            +0x1D8 int move_count
+++ *   +0x1DC int sub_phase                  +0x1E0 int is_move
+++ *   +0x218 u8 stop_flag                   +0x219 u8 abort_flag
+++ *   +0x21C int is_in_cali                 +0x2A0 int up_down_count
+++ *   +0x2A4 int all_count
+++ * The vendor allocates it with devm_kmalloc(), which leaves enable, target,
+++ * holder_mode, all_count and notify_str uninitialised; this rewrite uses
+++ * devm_kzalloc() instead.
+++ *
+++ * One move, replicated from vib_pwm_set_camera_state:
+++ *   wake lock if not held
+++ *   clk_set_rate(gp2_clk, freq)          (32000 for every normal move)
+++ *   bbk_hall_core_enable(0)
+++ *   clk_prepare(gp2_clk)
+++ *   dir = 0 for up, 1 for down
+++ *   boost = 1; msleep(3); enable = 0; sleep = 1; msleep(3)
+++ *   clk_enable(gp2_clk)
+++ *   hrtimer_start_range_ns(&timer, move_time, 0, HRTIMER_MODE_REL_PINNED)
+++ *   bbk_hall_core_enable(1)
+++ * and the stop path, used from the timer callback and from the emergency
+++ * thread, is boost = 0, msleep(5), enable = 1, sleep = 0, clk_disable, later
+++ * clk_unprepare.
+++ *
+++ * Move durations.  all_time (module parameter mhall_control7, 2839 by default)
+++ * is the duration of a full travel, and the intermediate positions are scaled
+++ * from it: the 69.6% position takes all_time * 696 / 1000.  Every duration is
+++ * then scaled by the ratio between the nominal 19200 Hz and the 32000 Hz the
+++ * move actually runs at, that is time * 6 / 10, before it is converted to
+++ * nanoseconds for the hrtimer.  Durations above 65536 run in two stages: a
+++ * 50 ms preliminary stage at 32000 Hz and then the remainder at 41600 Hz,
+++ * scaled by 6 / 13.
+++ *
+++ * SPDX-License-Identifier: GPL-2.0
+++ */
