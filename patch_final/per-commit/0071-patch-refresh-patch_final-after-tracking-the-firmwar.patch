+++++	/* the BBK hall framework registration */
+++++	struct hall_ops		hall_ops;
+++++	struct hall_dev		hall;
++++ };
++++ 
++++ static int m1120_i2c_set_reg(struct m1120_data *d, u8 reg, u8 val)
