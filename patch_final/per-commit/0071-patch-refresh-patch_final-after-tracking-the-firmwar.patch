+++	idx = q->index;			/* the write position holds the oldest */
+++	for (i = 0; i < q->size; i++) {
+++		up[i] = q->up[idx];
+++		down[i] = q->down[idx];
+++		idx = (idx + 1) % q->size;
+++	}
