+++++/* store */
+++++int val = 0;
+++++printk("\0016[LYQ-damon-vib]:------------%s want to set camera_state:%s\n",
+++++       "vib_pwm_camera_state_store", buf);   /* 第二个 %s 直接把用户写入的原文打出来 */
