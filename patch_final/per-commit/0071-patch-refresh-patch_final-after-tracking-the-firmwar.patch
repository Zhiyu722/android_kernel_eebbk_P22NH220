+++-++int __weak bbk_hall_core_read_data(s16 *up, s16 *down)
+++-++{
+++-++	if (up)
+++-++		*up = -2000;
+++-++	if (down)
+++-++		*down = -2000;
+++-++	return -1;
+++-++}
