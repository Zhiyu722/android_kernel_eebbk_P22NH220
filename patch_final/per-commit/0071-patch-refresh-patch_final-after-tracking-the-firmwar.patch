+--+++ *   gpio boost = 1
+--+++ *   msleep(3)
+--+++ *   gpio enable = 0
+--+++ *   gpio sleep = 1
+--+++ *   msleep(3)
+--+++ *   clk_enable(gp2_clk)
+--+++ *   hrtimer_start(&timer, move_time, HRTIMER_MODE_REL_PINNED)
