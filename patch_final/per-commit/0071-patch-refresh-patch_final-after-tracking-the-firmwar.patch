+++     'fs/stat.c compat newfstatat')
+++
+++edit('fs/stat.c',
+++'''	int error = vfs_fstat(fd, &stat);
+++
+++	if (!error)
+++		error = cp_new_stat(&stat, statbuf);
+++
+++	return error;''',
+++'''	int error = vfs_fstat(fd, &stat);
+++
+++	if (!error)
+++		error = cp_new_stat(&stat, statbuf);
