+++		pr_info("[LYQ-damon-hall]:---------ioctl: BBK_HALL_CORE_IOCTL_SET_MHALL_CALI after Hall Cali-------\n");
+++		return 0;
+++
+++	case BBK_HALL_CORE_IOCTL_SET_MHALL_CALI_DAEMON:
