+-++
+-++	switch (cmd) {
+-++	case BBK_HALL_CORE_IOCTL_SET_CALI:
+-++		memset(&g_hall_cali_data, 0, sizeof(g_hall_cali_data));
+-++		if (copy_from_user(&g_hall_cali_data, uarg, HALL_CALI_SIZE))
+-++			return -EFAULT;
+-++		if (hall_core_save_blob(CALI_PATH_HALL, &g_hall_cali_data,
+-++					HALL_CALI_SIZE))
+-++			return -1;
+-++		if (mhall_data)
