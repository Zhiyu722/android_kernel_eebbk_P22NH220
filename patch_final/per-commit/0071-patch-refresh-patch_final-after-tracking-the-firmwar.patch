++++	if (d->hall_up == dev)
++++		d->hall_up = NULL;
++++	if (d->hall_down == dev)
++++		d->hall_down = NULL;
++++}
++++EXPORT_SYMBOL_GPL(bbk_hall_core_unregister_device);
