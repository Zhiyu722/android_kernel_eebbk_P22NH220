+++static void destroy_kretprobe(struct kretprobe **rp_ptr)
+++{
+++    struct kretprobe *rp = *rp_ptr;
+++    if (!rp)
+++        return;
+++    unregister_kretprobe(rp);
+++    synchronize_rcu();
