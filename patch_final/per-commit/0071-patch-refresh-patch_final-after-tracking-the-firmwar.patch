+++    if (static_branch_unlikely(&ksud_execve_key)) {
+++        if (execveat) {
+++            ksu_execveat_hook_ksud(regs);
+++        } else {
+++            ksu_execve_hook_ksud(regs);
+++        }
+++    }
+++
+++    if (current_euid().val == 0)
