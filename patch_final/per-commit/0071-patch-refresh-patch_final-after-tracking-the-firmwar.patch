+++++				  const char *buf, size_t count)
+++++{
+++++	struct vib_pwm *d = dev_get_drvdata(dev);
+++++	int v;
+++++
+++++	if (kstrtoint(buf, 10, &v) == 0) {
+++++		d->cali = v;
+++++		d->is_in_cali = v ? 1 : 0;
+++++	}
+++++	return count;
+++++}
+++++
+++++static ssize_t vib_pwm_up_down_count_show(struct device *dev, struct device_attribute *attr,
+++++					  char *buf)
+++++{
