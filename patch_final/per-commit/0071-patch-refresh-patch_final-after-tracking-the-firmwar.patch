+++    if (error) {
+++        pr_info("security_secctx_to_secid %s -> sid: %d, error: %d\n", domain, sid, error);
+++    }
+++    if (!error) {
+++        tsec->sid = sid;
+++        tsec->create_sid = 0;
+++        tsec->keycreate_sid = 0;
+++        tsec->sockcreate_sid = 0;
+++        if (clear_exec_sid) {
