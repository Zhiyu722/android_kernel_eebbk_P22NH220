++++++		vib_update_key(VIB_KEY_NOTIFY3);
++++++	} else if (!strncmp(line, "0x284", 5) || !strncmp(line, "644", 3) ||
++++++		   !strncmp(line, "666", 3)) {
++++++		/* RESTART_CAMERA_ELEVATOR, following elevator_mode */
++++++		int mode = d->elevator_mode;
+++++ 
