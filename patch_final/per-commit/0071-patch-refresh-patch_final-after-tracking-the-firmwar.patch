++++++					const char *buf, size_t count)
++++++{
++++++	struct vib_pwm *d = dev_get_drvdata(dev);
++++++	int v;
++++++
++++++	if (kstrtoint(buf, 10, &v) == 0) {
++++++		d->state_init = v;
++++++		/* the vendor measures how long a full retract-to-up move takes */
++++++		if (v)
++++++			__pm_stay_awake(&d->wakeup);
++++++	}
++++++	return count;
++++++}
