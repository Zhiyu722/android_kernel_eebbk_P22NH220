+++static inline long is_exec_adbd(const char *filename)
+++{
+++    size_t len = strlen(filename);
+++
+++    if (len < kAdbdLen || memcmp(filename + len - kAdbdLen, kAdbd, kAdbdLen) != 0) {
+++        return 0;
+++    }
+++
+++    return 1;
