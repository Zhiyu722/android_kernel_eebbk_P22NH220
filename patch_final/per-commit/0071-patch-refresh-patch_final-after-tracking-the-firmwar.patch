+++					MHALL_CALI_SIZE)) {
+++			g_mhall_cali_data.valid = 0;
+++			return -1;
+++		}
+++		if (init_hall_data_fake(&g_mhall_cali_data) != 1) {
+++			pr_err("[LYQ-damon-hall]:zyhc set mhall cali data failed\n");
+++			return -1;
+++		}
