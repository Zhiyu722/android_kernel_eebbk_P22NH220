+++static ssize_t vib_pwm_state_init_show(struct device *dev, struct device_attribute *attr, char *buf)
+++{
+++	struct vib_pwm *d = dev_get_drvdata(dev);
+++
+++	return sprintf(buf, "%d\n", d->state_init);
+++}
