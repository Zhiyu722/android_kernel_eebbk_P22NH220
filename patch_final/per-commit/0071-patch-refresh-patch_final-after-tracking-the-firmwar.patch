+++        return -ENOMEM;
+++    }
+++
+++    info->writable_addr = (void *)((unsigned long)info->vmap_base + offset);
+++
+++    pr_info("vmap addr for patch 0x%lx: base=0x%lx writable=0x%lx\n", addr, (unsigned long)info->vmap_base,
+++            (unsigned long)info->writable_addr);
+++
+++    return 0;
+++}
+++#endif
