+++long ksu_strncpy_from_user_nofault(char *dst, const void __user *unsafe_addr, long count)
+++{
+++    mm_segment_t old_fs = get_fs();
+++    long ret;
+++
+++    if (unlikely(count <= 0))
+++        return 0;
+++
+++    set_fs(USER_DS);
+++    pagefault_disable();
+++    ret = strncpy_from_user(dst, unsafe_addr, count);
