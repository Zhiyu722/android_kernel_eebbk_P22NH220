++++++	if (!strncmp(line, "0x27c", 5) || !strncmp(line, "636", 3)) {
++++++		vib_pwm_set_camera(CAM_STATE_DOWN);
++++++		vib_update_key(VIB_KEY_DROP);
++++++	} else if (!strncmp(line, "0x27d", 5) || !strncmp(line, "637", 3)) {
