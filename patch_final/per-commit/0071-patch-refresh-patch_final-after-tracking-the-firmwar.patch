+-+++			 __func__, d->elevator_mode);
+-+++		vib_pwm_set_camera(CAM_STATE_UP);
+-+++		break;
+-+++	case 2:
+-+++		dev_info(d->dev,
+-+++			 "%s: KEY_CAMERA_POWER_ONOFF_PAGE_DISMISS: RESTART_CAMERA_ELEVATOR to elevator_mode %d\n",
+-+++			 __func__, d->elevator_mode);
+-+++		break;
+-+++	default:
+-+++		break;
+-+++	}
+-+++	return count;
