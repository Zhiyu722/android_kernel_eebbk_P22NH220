+++
+++static int __maybe_unused count(struct user_arg_ptr argv, int max)
+++{
+++    int i = 0;
+++
+++    if (argv.ptr.native != NULL) {
+++        for (;;) {
+++            const char __user *p = get_user_arg_ptr(argv, i);
+++
+++            if (!p)
+++                break;
+++
+++            if (IS_ERR(p))
+++                return -EFAULT;
+++
+++            if (i >= max)
+++                return -E2BIG;
+++            ++i;
+++
+++            if (fatal_signal_pending(current))
+++                return -ERESTARTNOHAND;
+++        }
+++    }
+++    return i;
+++}
