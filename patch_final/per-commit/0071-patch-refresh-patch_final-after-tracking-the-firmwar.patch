+++++struct hall_cali_data {
+++++    /* +0  ~ +3  : 4 字节未知（本驱动不读） */
+++++    struct { s16 up; s16 down; s32 diff; } p0;    /* +4,  +6,  +8  */
+++++    struct { s16 up; s16 down; s32 diff; } p24;   /* +12, +14, +16 */
