+++    /* Extract the user. */
+++    p = scontextp;
+++    while (*p && *p != ':')
+++        p++;
+++
+++    if (*p == 0)
+++        goto out;
+++
+++    *p++ = 0;
+++
+++    usrdatum = symtab_search(&pol->p_users, scontextp);
+++    if (!usrdatum)
+++        goto out;
+++
+++    ctx->user = usrdatum->value;
+++
+++    /* Extract role. */
+++    scontextp = p;
+++    while (*p && *p != ':')
+++        p++;
+++
+++    if (*p == 0)
+++        goto out;
+++
+++    *p++ = 0;
+++
+++    role = symtab_search(&pol->p_roles, scontextp);
+++    if (!role)
+++        goto out;
+++    ctx->role = role->value;
+++
+++    /* Extract type. */
+++    scontextp = p;
+++    while (*p && *p != ':')
+++        p++;
+++    oldc = *p;
+++    *p++ = 0;
