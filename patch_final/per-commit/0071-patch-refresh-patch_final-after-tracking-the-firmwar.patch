+++static bool add_type_rule(struct policydb *db, const char *s, const char *t, const char *c, const char *d, int effect)
+++{
+++    struct type_datum *src, *tgt, *def;
+++    struct class_datum *cls;
+++
+++    src = symtab_search(&db->p_types, s);
+++    if (src == NULL) {
